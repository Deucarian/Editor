.deucarian-workspace .dw-feature-scroll { flex-grow: 1; min-height: 0; }
.deucarian-workspace .dw-feature-page { padding-right: 8px; padding-bottom: 16px; }
.deucarian-workspace .dw-feature { border-width: 1px; border-color: var(--dw-border); border-radius: 4px; padding: 26px 28px; margin-bottom: 22px; flex-shrink: 0; }
.deucarian-workspace .dw-feature-header { flex-direction: row; align-items: flex-start; }
.deucarian-workspace .dw-feature-icon { width: 42px; height: 42px; margin-right: 30px; margin-top: 2px; }
.deucarian-workspace .dw-feature-heading { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.deucarian-workspace .dw-feature-title { font-size: 22px; -unity-font-style: bold; margin-bottom: 5px; }
.deucarian-workspace .dw-feature-description { font-size: 17px; color: var(--dw-muted); white-space: normal; }
.deucarian-workspace .dw-feature-status { font-size: 15px; color: var(--dw-muted); margin-top: 12px; white-space: normal; }
.deucarian-workspace .dw-feature-switch-row { flex-direction: row; align-items: center; margin-left: 20px; flex-shrink: 0; }
.deucarian-workspace .dw-feature-switch { margin: 0; padding: 0; width: 62px; min-width: 62px; height: 32px; }
.deucarian-workspace .dw-feature-switch > .unity-base-field__input { min-width: 62px; width: 62px; height: 32px; min-height: 32px; padding: 0; margin: 0; border-width: 1px; border-radius: 16px; border-color: var(--dw-border); background-color: #535e68; }
.deucarian-workspace .dw-feature-switch .unity-toggle__checkmark { position: absolute; left: 3px; top: 3px; width: 24px; height: 24px; margin: 0; padding: 0; border-width: 0; border-radius: 12px; background-image: none; background-color: #f4f7fa; opacity: 1; }
.deucarian-workspace .dw-feature-switch-on > .unity-base-field__input { background-color: #32bdc2; border-color: #32bdc2; }
.deucarian-workspace .dw-feature-switch-on .unity-toggle__checkmark { left: 33px; }
.deucarian-workspace .dw-feature-switch:focus > .unity-base-field__input { border-width: 2px; border-color: var(--dw-accent); }
.deucarian-workspace .dw-feature-switch-label { width: 34px; margin-left: 16px; font-size: 18px; }
.deucarian-workspace .dw-feature-details { margin-left: 72px; margin-top: 24px; border-top-width: 1px; border-top-color: var(--dw-border); padding-top: 20px; }
.deucarian-workspace .dw-feature-details .dw-field { margin-bottom: 12px; }
.deucarian-workspace .dw-feature-details .dw-field-label { width: 160px; min-width: 160px; }
.deucarian-workspace .dw-feature-connections { margin-top: 18px; border-top-width: 1px; border-top-color: var(--dw-border); padding-top: 20px; }
.deucarian-workspace .dw-feature-connections-title { margin-bottom: 16px; }
.deucarian-workspace .dw-feature-connection-list { flex-direction: row; flex-wrap: wrap; }
.deucarian-workspace .dw-feature-connection { flex-direction: row; align-items: center; min-width: 175px; width: 30%; margin-bottom: 12px; }
.deucarian-workspace .dw-feature-connection-icon { width: 25px; height: 25px; margin-right: 14px; padding: 4px; border-width: 2px; border-radius: 14px; border-color: var(--dw-muted); opacity: 0.4; }
.deucarian-workspace .dw-connected .dw-feature-connection-icon { -unity-background-image-tint-color: var(--dw-success); border-color: var(--dw-success); opacity: 1; }
.deucarian-workspace .dw-feature-actions { flex-direction: row; justify-content: flex-end; margin-top: 14px; }
.deucarian-workspace .dw-feature-actions .dw-primary { background-color: #32bdc2; border-color: #32bdc2; color: #102124; -unity-font-style: normal; height: 40px; padding-left: 24px; padding-right: 24px; }
.deucarian-workspace .dw-feature-information { flex-direction: row; align-items: center; margin-top: 4px; }
.deucarian-workspace .dw-feature-information .dw-icon { margin-right: 18px; }
.deucarian-workspace .dw-feature-information .unity-label { white-space: normal; flex-shrink: 1; }
.deucarian-workspace .dw-feature-compact { padding: 20px; }
.deucarian-workspace .dw-feature-compact .dw-feature-icon { width: 30px; height: 30px; margin-right: 16px; }
.deucarian-workspace .dw-feature-compact .dw-feature-details { margin-left: 0; }
.deucarian-workspace .dw-feature-compact .dw-feature-title { font-size: 19px; }
.deucarian-workspace .dw-feature-compact .dw-feature-description { font-size: 15px; }
.deucarian-workspace .dw-feature-compact .dw-feature-switch-row { margin-left: 12px; }
.deucarian-workspace .dw-feature-compact .dw-feature-switch-label { margin-left: 8px; }
.deucarian-workspace .dw-navigation-icon-group > .unity-toggle { flex-direction: row; align-items: center; min-height: 54px; padding-left: 26px; padding-right: 20px; color: var(--dw-text); }
.deucarian-workspace .dw-navigation-icon-group > .unity-toggle .unity-toggle__input { flex-grow: 1; flex-direction: row-reverse; }
.deucarian-workspace .dw-navigation-icon-group > .unity-toggle .unity-toggle__text { flex-grow: 1; margin-left: 0; font-size: 17px; }
.deucarian-workspace .dw-navigation-icon-group .dw-navigation-group-icon { margin-right: 24px; width: 26px; height: 26px; }
.deucarian-workspace .dw-navigation-icon-group > .unity-foldout__content { padding-left: 0; }
.deucarian-workspace .dw-nav-item.dw-nav-text-only { padding-left: 72px; min-height: 46px; }
.deucarian-workspace .dw-nav-item.dw-nav-text-only .dw-icon { display: none; }
.deucarian-workspace .dw-nav-item.dw-nav-text-only .dw-nav-label { font-size: 16px; }
