.deucarian-workspace .dw-steps-inline .dw-step-number { width: 44px; height: 44px; flex-shrink: 0; border-width: 2px; font-size: 23px; margin-right: 16px; }
.deucarian-workspace .dw-steps-inline .dw-step-label { margin: 0; padding: 0 16px 0 0; -unity-text-align: middle-left; font-size: 22px; }
.deucarian-workspace .dw-steps-inline .dw-step-line { position: relative; top: auto; left: auto; width: auto; height: 2px; flex-grow: 1; margin: 0 20px 0 0; }
.deucarian-workspace .dw-gallery-buttons { margin: 0; }
.deucarian-workspace .dw-gallery-buttons > .dw-button { flex-grow: 1; flex-basis: 20%; min-width: 160px; margin-right: 24px; }
.deucarian-workspace .dw-gallery-buttons > .dw-icon-button { flex-grow: 0; flex-basis: auto; min-width: 80px; }
.deucarian-workspace .dw-gallery-fields { flex-grow: 0; }
.deucarian-workspace .dw-gallery-fields > .dw-form-pane { flex-basis: 60%; padding-right: 60px; }
.deucarian-workspace .dw-gallery-fields > .dw-preview-pane { flex-basis: 40%; min-height: 0; border-width: 0; padding-left: 60px; }
.deucarian-workspace .dw-gallery-fields.dw-split-stacked > .dw-form-pane,
.deucarian-workspace .dw-gallery-fields.dw-split-stacked > .dw-preview-pane { flex-basis: auto; padding: 0; }
.deucarian-workspace .dw-gallery-sliders { max-width: 1030px; }
.deucarian-workspace .dw-gallery-statuses { flex-direction: row; flex-wrap: wrap; margin: 16px 0 30px; }
.deucarian-workspace .dw-gallery-status { flex-direction: row; align-items: center; min-width: 270px; margin-bottom: 14px; }
.deucarian-workspace .dw-gallery-status > .dw-icon { width: 44px; height: 44px; margin-right: 25px; }
.deucarian-workspace .dw-icon.dw-status-disabled { -unity-background-image-tint-color: var(--dw-muted); }
.deucarian-workspace .dw-collection-panels { margin-top: 18px; }
.deucarian-workspace .dw-collection-panels > .dw-form-pane { width: 30%; padding: 24px 16px; margin-right: 14px; border-width: 1px; border-color: var(--dw-border); border-radius: 5px; }
.deucarian-workspace .dw-collection-panels > .dw-preview-pane { width: auto; flex-grow: 1; flex-basis: 0; padding: 38px 48px; border-width: 1px; border-color: var(--dw-border); border-radius: 5px; }
.deucarian-workspace .dw-collection-local-scope > .dw-form-pane { width: 38%; }
.deucarian-workspace .dw-collection-local-scope .dw-scope { margin: 0 8px 16px; padding: 0; border-width: 0; }
.deucarian-workspace .dw-collection-panels.dw-split-stacked > .dw-form-pane { width: auto; max-height: 300px; flex-basis: 35%; margin-right: 0; }
.deucarian-workspace .dw-collection-panels.dw-split-stacked > .dw-preview-pane { width: auto; padding: 24px; }
.deucarian-workspace .dw-content-record > .dw-section-title { margin-bottom: 32px; }
.deucarian-workspace .dw-content-record > .dw-actions { margin-top: 36px; }
.deucarian-workspace.dw-authoring-page .dw-scope { flex-direction: column; align-items: stretch; }
.deucarian-workspace .dw-content-filters { flex-direction: row; flex-wrap: wrap; }
.deucarian-workspace .dw-content-filters > .dw-field { flex-basis: 240px; flex-grow: 1; margin-right: 12px; margin-bottom: 12px; }
.deucarian-workspace .dw-collection-local-scope .dw-content-filters > .dw-field { flex-direction: column; align-items: stretch; }
.deucarian-workspace .dw-collection-local-scope .dw-scope > .dw-search { margin-top: 4px; margin-bottom: 12px; }
.deucarian-workspace .dw-collection-local-scope .dw-collection-icon { border-width: 0; }
.deucarian-workspace .dw-record-heading { border-width: 0; border-bottom-width: 1px; border-radius: 0; padding: 0 0 24px; margin: 0 0 26px; }
.deucarian-workspace .dw-record-heading .dw-feature-header { margin-bottom: 0; }
.deucarian-workspace .dw-record-heading .dw-feature-details,
.deucarian-workspace .dw-record-heading .dw-feature-actions { display: none; }
.deucarian-workspace .dw-object-preview { min-height: 280px; margin: 18px 0; }
.deucarian-workspace .dw-range-pair { flex-direction: row; align-items: center; min-width: 0; }
.deucarian-workspace .dw-range-pair > .dw-slider { flex-grow: 1; flex-basis: 0; min-width: 70px; margin-right: 32px; }
.deucarian-workspace .dw-range-pair > .unity-base-text-field { width: 118px; min-width: 70px; flex-shrink: 1; }
.deucarian-workspace .dw-field > .dw-single-line { height: 60px; min-height: 60px; max-height: 60px; }
.deucarian-workspace .dw-field > .dw-single-line > .unity-base-field__input { height: 60px; max-height: 60px; }
.deucarian-workspace.dw-inspector .dw-field > .dw-single-line { height: 32px; min-height: 32px; max-height: 32px; }
.deucarian-workspace.dw-inspector .dw-field > .dw-single-line > .unity-base-field__input { height: 32px; max-height: 32px; }
.deucarian-workspace .dw-check-expanded > .dw-navigation-row > .dw-icon { rotate: 90deg; }
.deucarian-workspace .dw-note { white-space: normal; }
.deucarian-search-input .deucarian-search-glyph { width: 14px; height: 14px; margin-right: 5px; }
.deucarian-search-input .deucarian-search-caption { color: #bac3cd; font-size: 14px; }
.deucarian-workspace .deucarian-search-input .deucarian-search-glyph { width: 26px; height: 26px; margin: 0 14px; -unity-background-image-tint-color: var(--dw-muted); }
.deucarian-workspace .deucarian-search-input .deucarian-search-caption { color: var(--dw-muted); font-size: 24px; }
.deucarian-workspace .dw-filter-scope { align-items: stretch; flex-direction: column; padding-top: 0; border-width: 0; }
.deucarian-workspace .dw-filter-toolbar { flex-direction: row; align-items: flex-end; flex-wrap: wrap; }
.deucarian-workspace .dw-filter-toolbar > .dw-field { flex-direction: column; align-items: stretch; flex-basis: 500px; margin-bottom: 8px; }
.deucarian-workspace .dw-filter-toolbar > .dw-field > .dw-field-label { width: auto; margin: 0 0 10px; }
.deucarian-workspace .dw-filter-toolbar > .deucarian-search-input { flex-grow: 1; flex-basis: 560px; min-width: 0; height: 60px; margin: 0 24px 8px 0; }
.deucarian-workspace .dw-filter-toolbar > .dw-button { margin-bottom: 8px; }
.deucarian-workspace .dw-balanced-panels > .dw-form-pane { width: 48%; }
.deucarian-workspace .dw-balanced-panels { margin-bottom: 96px; }
.deucarian-workspace .dw-balanced-panels.dw-split-stacked > .dw-form-pane { width: auto; }
.deucarian-workspace .dw-balanced-panels.dw-split-stacked { margin-bottom: 12px; }
.deucarian-workspace .dw-collection-footer { flex-shrink: 0; margin-top: 20px; }
.deucarian-workspace .dw-balanced-panels .dw-collection-icon { border-width: 0; }
.deucarian-workspace .dw-detached-details > .dw-preview-pane { padding: 0; border-width: 0; }
.deucarian-workspace .dw-detached-details > .dw-form-pane { width: 41%; }
.deucarian-workspace .dw-detached-details.dw-split-stacked > .dw-form-pane { width: auto; }
.deucarian-workspace .dw-detached-details.dw-split-stacked > .dw-preview-pane { padding: 0; }
.deucarian-workspace .dw-equal-actions { margin-top: 32px; margin-bottom: 0; }
.deucarian-workspace .dw-equal-actions > .dw-button { flex-grow: 1; flex-basis: 0; min-width: 130px; }
.deucarian-workspace .dw-overview-focus.dw-status-compact { margin-bottom: 8px; }
.deucarian-workspace .dw-property-list > .dw-field { border-bottom-width: 1px; border-bottom-color: var(--dw-border); padding: 20px 0; margin-bottom: 0; }
.deucarian-workspace .dw-property-list > .dw-field > .dw-field-label { width: 56%; }
.deucarian-workspace .dw-end-actions > .dw-button { min-width: 210px; max-width: 100%; }
.deucarian-workspace .dw-package-collection.dw-collection-panels > .dw-form-pane { width: 58%; padding: 10px 0; }
.deucarian-workspace .dw-package-collection.dw-collection-panels > .dw-preview-pane { padding: 30px 24px 20px 42px; border-width: 0; border-left-width: 1px; border-radius: 0; }
.deucarian-workspace .dw-package-collection .dw-collection-icon { border-width: 0; margin-right: 20px; }
.deucarian-workspace .dw-package-collection .dw-collection-copy { flex-direction: row; align-items: center; }
.deucarian-workspace .dw-package-collection .dw-collection-copy > .dw-message-title { font-size: 24px; -unity-font-style: normal; flex-grow: 1; flex-basis: 0; margin-right: 24px; }
.deucarian-workspace .dw-package-collection .dw-collection-copy > .dw-muted { width: 105px; }
.deucarian-workspace .dw-package-collection .dw-collection-status { min-width: 155px; }
.deucarian-workspace .dw-package-collection .dw-primary { align-self: stretch; width: 100%; margin: 24px 0; }
.deucarian-workspace .dw-package-collection.dw-split-stacked > .dw-form-pane { width: auto; }
.deucarian-workspace .dw-package-collection.dw-split-stacked > .dw-preview-pane { padding: 24px; border-left-width: 0; }
.deucarian-workspace .dw-package-filters > .dw-field { flex-grow: 0; flex-basis: 520px; }
.deucarian-workspace .dw-package-filters > .dw-field > .dw-field-label { width: 120px; }
.deucarian-workspace .dw-package-filters > .deucarian-search-input { flex-grow: 1; flex-basis: 480px; max-width: 550px; height: 60px; margin-bottom: 8px; }
.deucarian-workspace .dw-update-bar { border-width: 1px; border-radius: 5px; padding: 18px 24px; margin: 28px 0 30px; }
.deucarian-workspace .dw-update-bar > .dw-button { margin-left: 18px; }
.deucarian-workspace .dw-operation-status { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; padding: 16px 0; border-top-width: 1px; border-top-color: var(--dw-border); }
.deucarian-workspace .dw-operation-status > .dw-icon { margin-right: 16px; }
.deucarian-workspace .dw-operation-status > .dw-muted { flex-grow: 1; flex-basis: 220px; min-width: 0; white-space: normal; margin-right: 16px; }
.deucarian-workspace .dw-operation-status > .dw-button { margin: 4px 0 4px 12px; }
.deucarian-workspace .dw-footer .deucarian-icon-text-button__label { font-size: 13px; }
.deucarian-workspace .dw-service-collection { margin-top: 0; margin-bottom: 120px; }
.deucarian-workspace .dw-service-collection.dw-collection-panels > .dw-form-pane { width: 27%; }
.deucarian-workspace .dw-service-collection .dw-collection-icon { width: 55px; border-width: 0; margin-right: 12px; }
.deucarian-workspace .dw-service-collection .dw-collection-copy > .dw-message-title { font-size: 24px; -unity-font-style: normal; }
.deucarian-workspace .dw-service-collection.dw-split-stacked { margin-bottom: 12px; }
.deucarian-workspace .dw-service-collection.dw-split-stacked > .dw-form-pane { width: auto; }
.deucarian-workspace .dw-session-panel { min-height: 800px; padding: 55px 190px 70px; }
.deucarian-workspace .dw-session-hero { flex-direction: column; align-items: center; justify-content: center; border-width: 0; padding: 45px 0 35px; margin: 0; background-color: rgba(0,0,0,0); }
.deucarian-workspace .dw-session-hero > .dw-icon { width: 120px; height: 120px; margin: 0 0 30px; -unity-background-image-tint-color: var(--dw-text); }
.deucarian-workspace .dw-session-hero > .dw-focus-text { flex-grow: 0; align-items: center; margin: 0; }
.deucarian-workspace .dw-session-hero .dw-focus-title, .deucarian-workspace .dw-session-hero .dw-focus-description { -unity-text-align: middle-center; }
.deucarian-workspace .dw-session-hero > .dw-focus-actions { margin: 34px 0 0; align-items: center; }
.deucarian-workspace .dw-session-hero .dw-button { min-width: 260px; }
.deucarian-workspace .dw-session-panel > .dw-field { margin: 12px 0; }
.deucarian-workspace .dw-session-panel > .dw-foldout { margin-top: 18px; }
.deucarian-workspace.dw-compact .dw-session-panel { min-height: 0; padding: 30px; }
.deucarian-workspace .dw-view-choices { align-self: flex-start; width: 580px; max-width: 100%; }
.deucarian-workspace .dw-feature-side-preview > .dw-form-pane { width: 68%; padding: 0 48px 0 0; border-width: 0; }
.deucarian-workspace .dw-feature-side-preview > .dw-preview-pane { width: 32%; flex-grow: 0; align-self: flex-start; padding: 0; }
.deucarian-workspace .dw-feature-side-preview.dw-split-stacked > .dw-form-pane { width: auto; padding: 0; }
.deucarian-workspace .dw-feature-side-preview.dw-split-stacked > .dw-preview-pane { width: 100%; margin-top: 24px; }
.deucarian-workspace .dw-spatial-axis { position: absolute; width: 28px; height: 30px; font-size: 18px; -unity-text-align: middle-center; }
.deucarian-workspace .dw-orientation-gizmo { position: absolute; left: 12px; bottom: 12px; width: 124px; height: 124px; }
.deucarian-workspace .dw-button.dw-search-result { height: auto; min-height: 88px; flex-shrink: 0; align-items: stretch; padding: 16px 20px; margin: 0 0 8px; border-left-width: 4px; border-left-color: transparent; -unity-text-align: middle-left; }
.deucarian-workspace .dw-search-result > .dw-message-title { font-size: 26px; white-space: normal; }
.deucarian-workspace .dw-search-result > .dw-muted { font-size: 22px; white-space: normal; margin-top: 6px; }
.deucarian-workspace .dw-search-result.dw-selected { border-left-color: var(--dw-accent); background-color: var(--dw-list-selected); }
.deucarian-workspace .dw-asset-control { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.deucarian-workspace .dw-asset-input-row { flex-direction: row; flex-wrap: wrap; align-items: center; min-width: 0; }
.deucarian-workspace .dw-asset-input-row > .unity-object-field { flex-grow: 1; flex-shrink: 1; flex-basis: 230px; min-width: 0; margin: 0 8px 4px 0; }
.deucarian-workspace .dw-asset-input-row > .dw-button { margin: 0 0 4px; }
.deucarian-workspace .dw-asset-control > .dw-actions { margin: 2px 0 0; align-items: center; }
.deucarian-workspace .dw-asset-origin { color: var(--dw-muted); font-size: 20px; margin-right: 14px; flex-shrink: 1; white-space: normal; }
.deucarian-workspace .dw-asset-control > .dw-actions > .dw-button { margin: 0 8px 0 0; }
