.deucarian-editor {
    --deucarian-bg: #23282b;
    --deucarian-panel: #202528;
    --deucarian-panel-soft: #24292c;
    --deucarian-panel-header: #24292c;
    --deucarian-sidebar: #202528;
    --deucarian-border: #41494e;
    --deucarian-border-active: #72e1df;
    --deucarian-text: #f2f4f7;
    --deucarian-muted: #bac3cd;
    --deucarian-teal: #72e1df;
    --deucarian-blue: #178f94;
    --deucarian-window-overlay: rgba(27, 26, 24, 0.18);
    --deucarian-control: #24292c;
    --deucarian-control-hover: #30393d;
    --deucarian-control-active: #214e52;
    --deucarian-green: #69cea0;
    --deucarian-amber: #ffcb4a;
    --deucarian-red: #ff6b70;
    --deucarian-grove: #8fa991;
    --deucarian-cobalt: #7995d5;
    --deucarian-tideline: #62bab6;
    --deucarian-oxblood: #d37a72;
    --deucarian-mineral: #aaa69e;
    --deucarian-brass: #d1a35a;
    --deucarian-ember: #d68855;
    --deucarian-graph-canvas: #191917;
    --deucarian-graph-canvas-inset: #141615;
    --deucarian-graph-surface: #2b2a27;
    --deucarian-graph-surface-raised: #34332f;
    --deucarian-graph-surface-hover: #303d3a;
    --deucarian-graph-surface-selected: #2b4644;
    --deucarian-graph-surface-related: #2d3734;
    --deucarian-graph-highlight: rgba(242, 239, 231, 0.055);
    --deucarian-graph-border: rgba(170, 166, 158, 0.28);
    --deucarian-graph-border-hover: rgba(98, 186, 182, 0.62);
    --deucarian-graph-border-selected: rgba(98, 186, 182, 0.92);
    --deucarian-graph-edge: rgba(170, 166, 158, 0.42);
    --deucarian-graph-edge-emphasis: rgba(98, 186, 182, 0.84);
    --deucarian-graph-edge-underlay: rgba(27, 26, 24, 0.78);
    --deucarian-graph-installed: #62bab6;
    --deucarian-graph-available: #aaa69e;
    --deucarian-graph-update: #d1a35a;
    --deucarian-graph-warning: #d68855;
    --deucarian-graph-missing: #d37a72;
    --deucarian-graph-checking: #7995d5;
    --deucarian-graph-unknown: rgba(170, 166, 158, 0.78);
    -unity-font: url("../Fonts/DINish-Regular.otf");
    background-color: var(--deucarian-bg);
    color: var(--deucarian-text);
}

.deucarian-inspector {
    padding: 8px 12px 12px 12px;
    min-width: 0;
    flex-grow: 1;
    color: var(--deucarian-text);
    background-color: var(--deucarian-bg);
}

.deucarian-editor.deucarian-theme--light {
    --deucarian-bg: #f6f8fa;
    --deucarian-panel: #edf1f4;
    --deucarian-panel-soft: #ffffff;
    --deucarian-panel-header: #ffffff;
    --deucarian-sidebar: #edf1f4;
    --deucarian-border: #bdc9d0;
    --deucarian-border-active: #006970;
    --deucarian-text: #202a32;
    --deucarian-muted: #52616d;
    --deucarian-teal: #006970;
    --deucarian-blue: #087b81;
    --deucarian-window-overlay: rgba(255, 255, 255, 0.10);
    --deucarian-control: #ffffff;
    --deucarian-control-hover: #e4edf0;
    --deucarian-control-active: #d5eeee;
    --deucarian-grove: #355545;
    --deucarian-cobalt: #234b91;
    --deucarian-tideline: #0f626a;
    --deucarian-oxblood: #8d2d2b;
    --deucarian-mineral: #5d5a55;
    --deucarian-brass: #8a642d;
    --deucarian-ember: #a44b31;
    --deucarian-graph-canvas: #f4f2eb;
    --deucarian-graph-canvas-inset: #edeae1;
    --deucarian-graph-surface: #ffffff;
    --deucarian-graph-surface-raised: #faf8f2;
    --deucarian-graph-surface-hover: #ebf7f5;
    --deucarian-graph-surface-selected: #daefec;
    --deucarian-graph-surface-related: #e9f4f2;
    --deucarian-graph-highlight: rgba(255, 255, 255, 0.58);
    --deucarian-graph-border: rgba(27, 26, 24, 0.16);
    --deucarian-graph-border-hover: rgba(15, 98, 106, 0.48);
    --deucarian-graph-border-selected: rgba(15, 98, 106, 0.76);
    --deucarian-graph-edge: rgba(93, 90, 85, 0.34);
    --deucarian-graph-edge-emphasis: rgba(15, 98, 106, 0.72);
    --deucarian-graph-edge-underlay: rgba(93, 90, 85, 0.20);
    --deucarian-graph-installed: #0f626a;
    --deucarian-graph-available: #5d5a55;
    --deucarian-graph-update: #8a642d;
    --deucarian-graph-warning: #a44b31;
    --deucarian-graph-missing: #8d2d2b;
    --deucarian-graph-checking: #234b91;
    --deucarian-graph-unknown: rgba(93, 90, 85, 0.78);
}

.deucarian-editor.deucarian-quiet {
    --deucarian-panel: #202528;
    --deucarian-panel-soft: #24292c;
    --deucarian-panel-header: #24292c;
    --deucarian-sidebar: #202528;
    --deucarian-border: #41494e;
}

.deucarian-editor.deucarian-quiet.deucarian-theme--light {
    --deucarian-panel: #edf1f4;
    --deucarian-panel-soft: #ffffff;
    --deucarian-panel-header: #ffffff;
    --deucarian-sidebar: #edf1f4;
    --deucarian-border: #bdc9d0;
}

.deucarian-quiet .deucarian-window-background,
.deucarian-quiet .deucarian-window-overlay,
.deucarian-quiet .deucarian-ambient-lighting-layer,
.deucarian-quiet .deucarian-grain-layer,
.deucarian-quiet .deucarian-vignette-layer,
.deucarian-quiet .deucarian-wallpaper-top-safe-fade,
.deucarian-quiet .deucarian-glass-sheen {
    display: none;
}

.deucarian-window-shell-host {
    flex-grow: 1;
    background-color: var(--deucarian-bg);
}

.deucarian-window-shell {
    flex-grow: 1;
    position: relative;
    background-color: var(--deucarian-bg);
}

.deucarian-window-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--deucarian-bg);
}

.deucarian-window-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--deucarian-window-overlay);
}

.deucarian-window-content {
    flex-grow: 1;
    position: relative;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.deucarian-package-header,
.deucarian-header {
    min-height: 58px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border-active);
    background-color: var(--deucarian-panel-header);
}

.deucarian-package-header__icon {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    max-width: 24px;
    max-height: 24px;
    margin-left: 0;
    margin-right: 10px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.deucarian-package-header__icon--brand {
    width: 42px;
    height: 42px;
    min-width: 42px;
    min-height: 42px;
    max-width: 42px;
    max-height: 42px;
    margin-right: 12px;
    -unity-background-image-tint-color: white;
}

.deucarian-package-header__text {
    min-width: 0;
    flex-grow: 1;
    justify-content: center;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.deucarian-package-header__title,
.deucarian-package-header__subtitle,
.deucarian-header__title,
.deucarian-header__subtitle {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-left;
}

.deucarian-package-header__title,
.deucarian-header__title {
    min-height: 22px;
    font-size: 18px;
    -unity-font: url("../Fonts/DINish-Light.otf");
    -unity-font-style: normal;
    color: var(--deucarian-text);
}

.deucarian-package-header__subtitle,
.deucarian-header__subtitle {
    min-height: 16px;
    font-size: 14px;
    color: var(--deucarian-muted);
}

.deucarian-window {
    flex-grow: 1;
    background-color: var(--deucarian-window-overlay);
    color: var(--deucarian-text);
}

.deucarian-sidebar {
    width: 216px;
    min-width: 216px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: var(--deucarian-sidebar);
    border-right-width: 1px;
    border-right-color: var(--deucarian-border);
}

.deucarian-sidebar__button {
    height: 34px;
    margin-bottom: 6px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: var(--deucarian-muted);
    -unity-text-align: middle-left;
}

.deucarian-sidebar__button:hover {
    background-color: var(--deucarian-panel-soft);
    color: var(--deucarian-text);
}

.deucarian-sidebar__button--active {
    background-color: var(--deucarian-control-active);
    color: var(--deucarian-text);
    border-left-width: 3px;
    border-left-color: var(--deucarian-teal);
}

.deucarian-panel {
    margin-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-panel);
}

.deucarian-panel--header {
    background-color: var(--deucarian-panel-header);
}

.deucarian-panel--nested {
    background-color: var(--deucarian-panel-soft);
}

.deucarian-panel:hover {
    border-left-color: var(--deucarian-border-active);
    border-right-color: var(--deucarian-border-active);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border-active);
}

.deucarian-toolbar-row {
    flex-direction: row;
    align-items: center;
    align-content: center;
    height: 54px;
    min-height: 54px;
    max-height: 54px;
    margin-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-panel-header);
}

.deucarian-toolbar-spacer {
    flex-grow: 1;
}

.deucarian-toggle-button {
    height: 24px;
    min-width: 116px;
    margin-right: 4px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    background-color: var(--deucarian-control);
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    color: var(--deucarian-muted);
}

.deucarian-toggle-button:hover {
    background-color: var(--deucarian-control-hover);
    color: var(--deucarian-text);
}

.deucarian-toggle-button--active {
    background-color: var(--deucarian-control-active);
    border-left-color: var(--deucarian-border-active);
    border-right-color: var(--deucarian-border-active);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border-active);
    color: var(--deucarian-text);
    -unity-font-style: bold;
}

/* Shared hybrid workbench -------------------------------------------------- */

.deucarian-workbench {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.deucarian-workbench__main {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: row;
    position: relative;
}

.deucarian-workbench__content {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.deucarian-workbench__drawer {
    min-width: 0;
    min-height: 0;
}

.deucarian-workbench__drawer--overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 45%;
    max-height: 260px;
    flex-grow: 0;
}

.deucarian-workbench__footer {
    flex-shrink: 0;
}

.deucarian-command-bar,
.deucarian-workbench-toolbar,
.dpi-view-toolbar {
    margin-bottom: 8px;
    flex-wrap: wrap;
    align-items: center;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-panel-header);
}

.deucarian-workbench-toolbar__summary,
.dpi-view-toolbar__summary {
    margin-left: 8px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: var(--deucarian-muted);
    font-size: 14px;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    min-width: 0;
    flex-shrink: 1;
    -unity-text-align: middle-left;
}

.deucarian-command-bar__action,
.deucarian-workbench-toolbar__action,
.dpi-view-toolbar__action {
    height: 36px;
    min-height: 36px;
    max-height: 36px;
    min-width: 86px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-control);
    color: var(--deucarian-text);
}

.deucarian-workbench-toolbar__action--icon {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.deucarian-icon-text-button {
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 36px;
    min-height: 36px;
    max-height: 36px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
}

.deucarian-icon-text-button__content {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    min-width: 0;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.deucarian-icon-text-button__icon,
.deucarian-workbench-toolbar__icon {
    width: 14px;
    height: 14px;
    min-width: 14px;
    min-height: 14px;
    max-width: 14px;
    max-height: 14px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.deucarian-icon-text-button__gap {
    width: 8px;
    min-width: 8px;
    max-width: 8px;
    height: 1px;
    min-height: 1px;
    max-height: 1px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.deucarian-icon-text-button__label,
.deucarian-workbench-toolbar__icon-label {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    flex-shrink: 1;
    -unity-text-align: middle-center;
}

.deucarian-icon-text-button--leading .deucarian-icon-text-button__content {
    justify-content: flex-start;
}

.deucarian-icon-text-button--leading .deucarian-icon-text-button__label {
    -unity-text-align: middle-left;
}

.deucarian-workbench-toolbar__action--standard:hover,
.dpi-view-toolbar__graph-action:hover {
    border-left-color: var(--deucarian-border-active);
    border-right-color: var(--deucarian-border-active);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border-active);
    background-color: var(--deucarian-control-hover);
    color: var(--deucarian-text);
}

.deucarian-workbench-toolbar__action--standard:active,
.dpi-view-toolbar__graph-action:active {
    border-left-color: var(--deucarian-border-active);
    border-right-color: var(--deucarian-border-active);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border-active);
    background-color: var(--deucarian-control-active);
    color: var(--deucarian-text);
}

.deucarian-workbench-toolbar__action--emphasized,
.deucarian-workbench-toolbar__toggle,
.dpi-view-toolbar__channel-button {
    min-width: 124px;
    margin-right: 2px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-control);
}

.deucarian-workbench-toolbar__toggle--active {
    background-color: var(--deucarian-control-active);
    border-left-color: var(--deucarian-border-active);
    border-right-color: var(--deucarian-border-active);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border-active);
    color: var(--deucarian-text);
    -unity-font-style: bold;
}

.deucarian-workbench-toolbar__action--emphasized:hover,
.deucarian-workbench-toolbar__toggle:hover,
.dpi-view-toolbar__channel-button:hover {
    border-left-color: var(--deucarian-border-active);
    border-right-color: var(--deucarian-border-active);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border-active);
    background-color: var(--deucarian-control-hover);
}

.deucarian-command-bar__spacer,
.deucarian-workbench-toolbar__spacer,
.dpi-view-toolbar__spacer {
    flex-grow: 1;
}

.deucarian-command-bar__navigation,
.deucarian-command-bar__actions,
.deucarian-workbench-toolbar__group {
    min-width: 0;
    height: 36px;
    min-height: 36px;
    max-height: 36px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.deucarian-command-bar__leading,
.deucarian-command-bar__trailing {
    height: 36px;
    min-height: 36px;
    max-height: 36px;
}

.deucarian-command-bar__summary {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-left;
}

.deucarian-command-bar__actions,
.deucarian-workbench-toolbar__group--actions {
    justify-content: flex-end;
}

.deucarian-command-bar__reserved-slot,
.deucarian-workbench-toolbar__reserved-slot {
    height: 36px;
    min-height: 36px;
    max-height: 36px;
    margin-left: 4px;
    flex-grow: 0;
    flex-shrink: 0;
}

.deucarian-workbench-toolbar__reserved-slot > .deucarian-workbench-toolbar__action,
.deucarian-workbench-toolbar__reserved-slot > .deucarian-workbench-toolbar__status-pill {
    width: 100%;
    min-width: 100%;
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
}

.deucarian-command-bar__state,
.deucarian-workbench-toolbar__status-pill {
    height: 36px;
    min-height: 36px;
    max-height: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-control);
    color: var(--deucarian-text);
}

.deucarian-workbench-toolbar__status-pill > .deucarian-icon-text-button__content {
    width: 100%;
    height: 18px;
}

.deucarian-workbench-toolbar--stable-action-lanes {
    flex-wrap: nowrap;
}

.deucarian-responsive--compact .deucarian-workbench-toolbar__action,
.deucarian-responsive--compact .dpi-view-toolbar__action,
.dpi-responsive--compact .deucarian-workbench-toolbar__action,
.dpi-responsive--compact .dpi-view-toolbar__action {
    min-width: 76px;
}

.deucarian-responsive--compact .deucarian-workbench-toolbar__action--emphasized,
.deucarian-responsive--compact .deucarian-workbench-toolbar__toggle,
.deucarian-responsive--compact .dpi-view-toolbar__channel-button,
.dpi-responsive--compact .deucarian-workbench-toolbar__action--emphasized,
.dpi-responsive--compact .deucarian-workbench-toolbar__toggle,
.dpi-responsive--compact .dpi-view-toolbar__channel-button {
    min-width: 112px;
}

.deucarian-responsive--narrow .deucarian-workbench__main,
.dpi-responsive--narrow .deucarian-workbench__main {
    flex-direction: column;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar,
.deucarian-responsive--narrow .dpi-view-toolbar,
.dpi-responsive--narrow .deucarian-workbench-toolbar,
.dpi-responsive--narrow .dpi-view-toolbar {
    height: 94px;
    min-height: 94px;
    max-height: 94px;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    align-content: flex-start;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar__spacer,
.deucarian-responsive--narrow .dpi-view-toolbar__spacer,
.dpi-responsive--narrow .deucarian-workbench-toolbar__spacer,
.dpi-responsive--narrow .dpi-view-toolbar__spacer {
    display: none;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar__summary,
.deucarian-responsive--narrow .dpi-view-toolbar__summary,
.dpi-responsive--narrow .deucarian-workbench-toolbar__summary,
.dpi-responsive--narrow .dpi-view-toolbar__summary {
    width: 100%;
    margin-left: 0;
    margin-top: 4px;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar--stable-action-lanes,
.dpi-responsive--narrow .deucarian-workbench-toolbar--stable-action-lanes {
    height: 94px;
    min-height: 94px;
    max-height: 94px;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    flex-wrap: nowrap;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar--stable-action-lanes .deucarian-command-bar__summary,
.dpi-responsive--narrow .deucarian-workbench-toolbar--stable-action-lanes .deucarian-command-bar__summary {
    display: none;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar--stable-action-lanes .deucarian-workbench-toolbar__group,
.dpi-responsive--narrow .deucarian-workbench-toolbar--stable-action-lanes .deucarian-workbench-toolbar__group {
    width: 100%;
    min-height: 36px;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar--stable-action-lanes .deucarian-workbench-toolbar__group--actions,
.dpi-responsive--narrow .deucarian-workbench-toolbar--stable-action-lanes .deucarian-workbench-toolbar__group--actions {
    margin-top: 4px;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar--compact-single-line,
.dpi-responsive--narrow .deucarian-workbench-toolbar--compact-single-line {
    height: 54px;
    min-height: 54px;
    max-height: 54px;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    align-content: center;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar--compact-single-line .deucarian-workbench-toolbar__spacer,
.dpi-responsive--narrow .deucarian-workbench-toolbar--compact-single-line .deucarian-workbench-toolbar__spacer {
    display: flex;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar--compact-single-line .deucarian-workbench-toolbar__summary,
.dpi-responsive--narrow .deucarian-workbench-toolbar--compact-single-line .deucarian-workbench-toolbar__summary {
    width: auto;
    margin-left: 6px;
    margin-top: 0;
    flex-grow: 0;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar--compact-single-line .deucarian-command-bar__summary,
.dpi-responsive--narrow .deucarian-workbench-toolbar--compact-single-line .deucarian-command-bar__summary {
    width: auto;
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 0;
    flex-grow: 1;
}

/* Shared workbench drawer and footer. The dpi aliases preserve the released
   Package Installer contract while allowing consumers to migrate incrementally. */

.deucarian-workbench-operation-surface,
.dpi-operation-surface {
    --deucarian-workbench-operation-inline-padding: 10px;
    --deucarian-workbench-operation-block-padding: 8px;
    --deucarian-workbench-operation-footer-inline-padding: 10px;
    --deucarian-workbench-operation-footer-block-padding: 0px;
    --deucarian-workbench-operation-row-gap: 6px;
    --deucarian-workbench-operation-control-gap: 8px;
    --deucarian-workbench-operation-footer-height: 46px;
    --dpi-operation-inline-padding: 10px;
    --dpi-operation-block-padding: 8px;
    --dpi-operation-footer-inline-padding: 10px;
    --dpi-operation-footer-block-padding: 0px;
    --dpi-operation-row-gap: 6px;
    --dpi-operation-control-gap: 8px;
    --dpi-operation-footer-height: 46px;
}

.deucarian-workbench-operation-drawer,
.dpi-operation-drawer {
    flex-shrink: 0;
    height: 0;
    min-height: 0;
    max-height: 0;
    margin-top: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    background-color: rgba(17, 29, 39, 0.00);
    overflow: hidden;
}

.deucarian-workbench-operation-drawer--expanded,
.dpi-operation-drawer--expanded {
    display: flex;
    height: 220px;
    min-height: 180px;
    max-height: 260px;
    margin-bottom: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-panel-header);
}

.deucarian-workbench-operation-drawer--collapsed,
.dpi-operation-drawer--collapsed {
    display: none;
    margin-bottom: 0;
    background-color: rgba(17, 29, 39, 0.00);
}

.deucarian-workbench__drawer--overlay .deucarian-workbench-operation-drawer--expanded {
    height: 100%;
    min-height: 0;
    max-height: 100%;
    margin-bottom: 0;
}

.deucarian-workbench-operation-drawer__scroll,
.dpi-operation-drawer__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.deucarian-workbench-operation-content,
.dpi-operation-content {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-left: var(--deucarian-workbench-operation-inline-padding);
    padding-right: var(--deucarian-workbench-operation-inline-padding);
    padding-top: var(--deucarian-workbench-operation-block-padding);
    padding-bottom: var(--deucarian-workbench-operation-block-padding);
}

.deucarian-workbench-operation-drawer__header {
    height: 30px;
    min-height: 30px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 6px;
}

.deucarian-workbench-operation-drawer__header-title {
    color: var(--deucarian-text);
    font-size: 16px;
    -unity-font-style: bold;
}

.deucarian-workbench-operation-drawer__columns {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.deucarian-workbench-operation-drawer__column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 10px;
}

.deucarian-workbench-operation-drawer__group-title {
    height: 20px;
    color: var(--deucarian-muted);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.deucarian-workbench-operation-drawer__action {
    height: 36px;
    min-height: 36px;
    margin-top: 0;
    margin-bottom: 4px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-control);
    color: var(--deucarian-text);
}

.deucarian-workbench-operation-drawer__action:hover {
    border-left-color: var(--deucarian-border-active);
    border-right-color: var(--deucarian-border-active);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border-active);
    background-color: var(--deucarian-control-hover);
}

.deucarian-workbench-operation-drawer__action .deucarian-icon-text-button__label {
    -unity-text-align: middle-left;
}

.deucarian-workbench-operation-drawer__action .deucarian-icon-text-button__icon {
    margin-right: 0;
}

.deucarian-responsive--narrow .deucarian-workbench-operation-drawer__columns,
.dpi-responsive--narrow .deucarian-workbench-operation-drawer__columns {
    flex-direction: column;
}

.deucarian-responsive--narrow .deucarian-workbench-operation-drawer__column,
.dpi-responsive--narrow .deucarian-workbench-operation-drawer__column {
    flex-grow: 0;
    flex-basis: auto;
    width: 100%;
    margin-right: 0;
}

.deucarian-workbench-operation-row,
.dpi-operation-row {
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: var(--deucarian-workbench-operation-row-gap);
}

.deucarian-workbench-operation-row--header,
.deucarian-workbench-operation-row--option,
.dpi-operation-row--header,
.dpi-operation-row--option {
    flex-direction: row;
    align-items: center;
}

.deucarian-workbench-operation-row--message,
.dpi-operation-row--message {
    flex-shrink: 1;
    margin-bottom: 0;
}

.deucarian-workbench-operation-text--primary,
.dpi-operation-text--primary {
    color: var(--deucarian-text);
}

.deucarian-workbench-operation-text--secondary,
.dpi-operation-text--secondary {
    color: var(--deucarian-muted);
}

.deucarian-workbench-operation-drawer__title,
.dpi-operation-drawer__title {
    -unity-font-style: bold;
    font-size: 16px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.deucarian-workbench-operation-drawer__toggle,
.dpi-operation-drawer__toggle {
    flex-shrink: 0;
    margin-left: 0;
    margin-right: var(--deucarian-workbench-operation-control-gap);
    margin-top: 0;
    margin-bottom: 0;
}

.deucarian-workbench-operation-drawer__option-label,
.dpi-operation-drawer__option-label {
    font-size: 14px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.deucarian-workbench-operation-drawer__message,
.dpi-operation-drawer__message {
    font-size: 14px;
    white-space: normal;
    overflow: visible;
}

.deucarian-workbench-operation-footer,
.dpi-operation-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: var(--deucarian-workbench-operation-footer-height);
    min-height: var(--deucarian-workbench-operation-footer-height);
    max-height: var(--deucarian-workbench-operation-footer-height);
    margin-top: 0;
    padding-left: var(--deucarian-workbench-operation-footer-inline-padding);
    padding-right: var(--deucarian-workbench-operation-footer-inline-padding);
    padding-top: var(--deucarian-workbench-operation-footer-block-padding);
    padding-bottom: var(--deucarian-workbench-operation-footer-block-padding);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-panel-header);
    overflow: hidden;
}

.deucarian-workbench-operation-footer__status,
.dpi-operation-footer__status {
    flex-direction: row;
    align-items: center;
    height: 100%;
    flex-shrink: 0;
    min-width: 76px;
    margin-right: var(--deucarian-workbench-operation-control-gap);
}

.deucarian-workbench-operation-footer__status-content {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: auto;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    flex-grow: 0;
    flex-shrink: 0;
}

.deucarian-workbench-operation-footer__status-icon,
.dpi-operation-footer__status-icon {
    width: 14px;
    min-width: 14px;
    max-width: 14px;
    height: 14px;
    min-height: 14px;
    max-height: 14px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
}

.deucarian-workbench-operation-footer__status-icon--success,
.dpi-operation-footer__status-icon--installed {
    color: var(--deucarian-green);
}

.deucarian-workbench-operation-footer__status-icon--neutral,
.dpi-operation-footer__status-icon--not-installed,
.dpi-operation-footer__status-icon--info {
    color: var(--deucarian-muted);
}

.deucarian-workbench-operation-footer__status-icon--warning,
.dpi-operation-footer__status-icon--attention {
    color: var(--deucarian-amber);
}

.deucarian-workbench-operation-footer__status-icon--error,
.dpi-operation-footer__status-icon--failed {
    color: var(--deucarian-red);
}

.deucarian-workbench-operation-footer__status-icon--busy,
.dpi-operation-footer__status-icon--busy {
    color: var(--deucarian-teal);
}

.deucarian-workbench-operation-footer__status-label,
.dpi-operation-footer__status-label {
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    flex-shrink: 0;
    color: var(--deucarian-text);
    font-size: 14px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.deucarian-workbench-operation-footer__summary,
.dpi-operation-footer__summary {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    margin-left: 0;
    margin-right: var(--deucarian-workbench-operation-control-gap);
    color: var(--deucarian-muted);
    font-size: 14px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.deucarian-workbench-operation-footer__spacer,
.dpi-operation-footer__spacer {
    width: 0;
    min-width: 0;
    max-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.deucarian-workbench-operation-footer__actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.deucarian-workbench-operation-footer__action,
.dpi-operation-footer__details-button {
    width: 96px;
    min-width: 96px;
    max-width: 96px;
    height: 36px;
    min-height: 36px;
    max-height: 36px;
    margin-left: 0;
    margin-right: var(--deucarian-workbench-operation-control-gap);
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-control);
    color: var(--deucarian-text);
    font-size: 14px;
}

.deucarian-workbench-operation-footer__action:hover,
.dpi-operation-footer__details-button:hover {
    border-left-color: var(--deucarian-border-active);
    border-right-color: var(--deucarian-border-active);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border-active);
    background-color: var(--deucarian-control-hover);
}

.deucarian-workbench-operation-footer__action:active,
.dpi-operation-footer__details-button:active {
    border-left-color: rgba(59, 209, 191, 0.76);
    border-right-color: rgba(59, 209, 191, 0.76);
    border-top-color: rgba(59, 209, 191, 0.76);
    border-bottom-color: rgba(59, 209, 191, 0.76);
    background-color: var(--deucarian-control-active);
}

.deucarian-workbench-operation-footer__version,
.dpi-operation-footer__version {
    flex-shrink: 0;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    color: var(--deucarian-text);
    font-size: 14px;
    -unity-text-align: middle-right;
    white-space: nowrap;
    overflow: hidden;
}

.deucarian-section {
    margin-bottom: 8px;
}

.deucarian-section__title {
    margin-bottom: 8px;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--deucarian-muted);
}

.deucarian-card {
    min-height: 112px;
    margin-right: 10px;
    margin-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-panel);
}

.deucarian-card:hover {
    background-color: var(--deucarian-panel-soft);
}

.deucarian-badge {
    height: 20px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    background-color: #2b3b44;
    color: var(--deucarian-text);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.deucarian-badge--success {
    background-color: #2f6b4e;
}

.deucarian-badge--warning {
    background-color: #735b2e;
}

.deucarian-badge--error {
    background-color: #743737;
}

.deucarian-button {
    height: 36px;
    min-width: 94px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.deucarian-button--primary {
    background-color: var(--deucarian-blue);
    color: var(--deucarian-text);
    -unity-font-style: bold;
}

.deucarian-status-row {
    flex-direction: row;
    align-items: center;
    min-height: 36px;
    margin-bottom: 6px;
}

.deucarian-muted {
    color: var(--deucarian-muted);
}

.deucarian-fixed-wallpaper-layer,
.deucarian-fixed-wallpaper-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.deucarian-readability-overlay {
    background-color: var(--deucarian-window-overlay);
}

.deucarian-wallpaper-safe-shell {
    overflow: hidden;
}

.deucarian-wallpaper-top-safe-fade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 86px;
    background-color: rgba(27, 26, 24, 0.46);
}

.deucarian-ambient-lighting-layer,
.deucarian-grain-layer,
.deucarian-vignette-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.deucarian-ambient-lighting-layer {
    overflow: hidden;
}

.deucarian-ambient-glow {
    position: absolute;
    width: 720px;
    height: 720px;
    -unity-background-scale-mode: scale-and-crop;
}

.deucarian-ambient-glow--teal {
    left: -170px;
    top: 38%;
}

.deucarian-ambient-glow--blue {
    right: -150px;
    top: 70px;
    width: 660px;
    height: 660px;
}

.deucarian-ambient-glow--indigo {
    right: 8%;
    bottom: -250px;
    width: 620px;
    height: 620px;
}

.deucarian-grain-layer {
    opacity: 0.24;
    -unity-background-scale-mode: scale-and-crop;
}

.deucarian-vignette-layer {
    opacity: 0.90;
    -unity-background-scale-mode: stretch-to-fill;
}

.deucarian-glass-sheen {
    position: absolute;
    left: -64px;
    top: -20%;
    width: 34px;
    height: 142%;
    background-color: rgba(218, 246, 250, 0.22);
    opacity: 0;
}

.deucarian-dialog .deucarian-window-content {
    justify-content: center;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 14px;
    padding-bottom: 14px;
}

.deucarian-dialog__card {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 18px;
    padding-bottom: 14px;
    background-color: var(--deucarian-panel-header);
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border);
}

.deucarian-dialog__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
    align-items: flex-start;
}

.deucarian-dialog__icon {
    width: 42px;
    min-width: 42px;
    max-width: 42px;
    height: 42px;
    min-height: 42px;
    max-height: 42px;
    margin-right: 16px;
    opacity: 0.94;
    -unity-background-image-tint-color: var(--deucarian-text);
}

.deucarian-dialog__copy-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.deucarian-dialog__copy {
    flex-shrink: 0;
    min-width: 0;
}

.deucarian-dialog__title {
    flex-shrink: 0;
    color: var(--deucarian-text);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 8px;
}

.deucarian-dialog__message {
    flex-shrink: 0;
    color: var(--deucarian-text);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 8px;
}

.deucarian-dialog__details {
    flex-shrink: 0;
    min-height: 54px;
    margin-top: 4px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: var(--deucarian-panel-soft);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.deucarian-dialog__details-text {
    color: var(--deucarian-muted);
    font-size: 12px;
    white-space: normal;
}

.deucarian-dialog__actions {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    min-height: 36px;
    margin-top: 12px;
}

.deucarian-dialog__action {
    min-width: 104px;
    margin-left: 8px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.deucarian-dialog__action--primary {
    border-left-color: rgba(92, 201, 194, 0.82);
    border-right-color: rgba(92, 201, 194, 0.62);
    border-top-color: rgba(92, 201, 194, 0.62);
    border-bottom-color: rgba(92, 201, 194, 0.62);
    background-color: var(--deucarian-blue);
    color: var(--deucarian-text);
    -unity-font-style: bold;
}

.deucarian-dialog__action--primary:hover {
    border-left-color: rgba(122, 231, 222, 0.94);
    border-right-color: rgba(122, 231, 222, 0.76);
    border-top-color: rgba(122, 231, 222, 0.76);
    border-bottom-color: rgba(122, 231, 222, 0.76);
    background-color: var(--deucarian-teal);
}

.deucarian-editor.deucarian-theme--light .deucarian-wallpaper-top-safe-fade {
    background-color: rgba(255, 255, 255, 0.52);
}

.deucarian-editor.deucarian-theme--light .deucarian-grain-layer {
    opacity: 0.10;
}

.deucarian-editor.deucarian-theme--light .deucarian-vignette-layer {
    opacity: 0.42;
}

.deucarian-editor.deucarian-theme--light .deucarian-glass-sheen {
    background-color: rgba(255, 255, 255, 0.54);
}

.deucarian-dialog__action--destructive {
    border-left-color: rgba(211, 106, 104, 0.68);
    border-right-color: rgba(211, 106, 104, 0.48);
    border-top-color: rgba(211, 106, 104, 0.48);
    border-bottom-color: rgba(211, 106, 104, 0.48);
    background-color: rgba(75, 35, 39, 0.84);
}

.deucarian-dialog__action--destructive:hover {
    border-left-color: rgba(241, 139, 136, 0.86);
    border-right-color: rgba(241, 139, 136, 0.68);
    border-top-color: rgba(241, 139, 136, 0.68);
    border-bottom-color: rgba(241, 139, 136, 0.68);
    background-color: rgba(94, 43, 47, 0.90);
}

.deucarian-dialog--narrow .deucarian-dialog__card {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 14px;
    padding-bottom: 10px;
}

.deucarian-dialog--narrow .deucarian-dialog__body {
    flex-direction: column;
    align-items: stretch;
}

.deucarian-dialog--narrow .deucarian-dialog__icon {
    width: 36px;
    min-width: 36px;
    max-width: 36px;
    height: 36px;
    min-height: 36px;
    max-height: 36px;
    margin-right: 0;
    margin-bottom: 10px;
    align-self: center;
}

.deucarian-dialog--narrow .deucarian-dialog__title {
    -unity-text-align: middle-center;
}

.deucarian-dialog--narrow .deucarian-dialog__actions {
    flex-direction: column;
    align-items: stretch;
}

.deucarian-dialog--narrow .deucarian-dialog__action {
    width: 100%;
    margin-left: 0;
    margin-top: 4px;
    margin-bottom: 4px;
}

.deucarian-section-title,
.deucarian-icon-text-button__label,
.deucarian-workbench-toolbar__icon-label,
.deucarian-toggle-button,
.deucarian-workbench-toolbar__action,
.deucarian-dialog__action {
    -unity-font: url("../Fonts/DINish-SemiBold.otf");
    -unity-font-style: normal;
}

/* Native toolkit controls outside a full workspace share the same visual vocabulary. */
.deucarian-editor .unity-button {
    min-height: 32px; padding: 0 12px; font-size: 14px;
    border-width: 1px; border-radius: 5px;
    background-color: var(--deucarian-control); border-color: var(--deucarian-border);
    color: var(--deucarian-text); -unity-text-align: middle-center;
}
.deucarian-editor .unity-button:hover,
.deucarian-editor .unity-button:focus { border-color: var(--deucarian-border-active); background-color: var(--deucarian-control-hover); }
.deucarian-editor .deucarian-button--primary,
.deucarian-editor .deucarian-workbench-toolbar__action--emphasized { background-color: var(--deucarian-blue); color: #ffffff; }
