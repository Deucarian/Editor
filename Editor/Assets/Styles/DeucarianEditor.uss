.deucarian-editor {
    --deucarian-bg: #11161a;
    --deucarian-panel: rgba(23, 32, 39, 0.72);
    --deucarian-panel-soft: rgba(32, 47, 56, 0.62);
    --deucarian-panel-header: rgba(35, 52, 61, 0.68);
    --deucarian-sidebar: rgba(23, 32, 39, 0.72);
    --deucarian-border: rgba(90, 111, 160, 0.35);
    --deucarian-border-active: rgba(59, 166, 154, 0.55);
    --deucarian-text: #e7edf0;
    --deucarian-muted: #9aa8b1;
    --deucarian-teal: #3ba69a;
    --deucarian-blue: #5a6fa0;
    --deucarian-green: #5fbf86;
    --deucarian-amber: #d99d48;
    --deucarian-red: #d36a68;
    background-color: var(--deucarian-bg);
    color: var(--deucarian-text);
}

.deucarian-window-shell-host {
    flex-grow: 1;
    background-color: #0d1218;
}

.deucarian-window-shell {
    flex-grow: 1;
    position: relative;
    background-color: #0d1218;
}

.deucarian-window-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #0d1218;
}

.deucarian-window-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(1, 4, 8, 0.24);
}

.deucarian-window-content {
    flex-grow: 1;
    position: relative;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 10px;
}

.deucarian-window {
    flex-grow: 1;
    background-color: rgba(13, 18, 24, 0.22);
    color: var(--deucarian-text);
}

.deucarian-header {
    flex-direction: row;
    align-items: center;
    min-height: 90px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: var(--deucarian-panel-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--deucarian-border);
}

.deucarian-header__title {
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--deucarian-text);
}

.deucarian-header__subtitle {
    font-size: 12px;
    color: var(--deucarian-muted);
}

.deucarian-sidebar {
    width: 216px;
    min-width: 216px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: var(--deucarian-sidebar);
    border-right-width: 1px;
    border-right-color: var(--deucarian-border);
}

.deucarian-sidebar__button {
    height: 34px;
    margin-bottom: 6px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    background-color: transparent;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: var(--deucarian-muted);
    -unity-text-align: middle-left;
}

.deucarian-sidebar__button:hover {
    background-color: var(--deucarian-panel-soft);
    color: var(--deucarian-text);
}

.deucarian-sidebar__button--active {
    background-color: rgba(35, 62, 66, 0.58);
    color: var(--deucarian-text);
    border-left-width: 3px;
    border-left-color: var(--deucarian-teal);
}

.deucarian-panel {
    margin-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-panel);
}

.deucarian-panel--header {
    background-color: var(--deucarian-panel-header);
}

.deucarian-panel--nested {
    background-color: var(--deucarian-panel-soft);
}

.deucarian-panel:hover {
    border-left-color: var(--deucarian-border-active);
    border-right-color: var(--deucarian-border-active);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border-active);
}

.deucarian-toolbar-row {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    margin-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-panel-header);
}

.deucarian-toolbar-spacer {
    flex-grow: 1;
}

.deucarian-toggle-button {
    height: 24px;
    min-width: 116px;
    margin-right: 4px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    background-color: rgba(32, 47, 56, 0.44);
    border-left-color: rgba(90, 111, 160, 0.25);
    border-right-color: rgba(90, 111, 160, 0.25);
    border-top-color: rgba(90, 111, 160, 0.25);
    border-bottom-color: rgba(90, 111, 160, 0.25);
    color: var(--deucarian-muted);
}

.deucarian-toggle-button:hover {
    background-color: rgba(32, 47, 56, 0.68);
    color: var(--deucarian-text);
}

.deucarian-toggle-button--active {
    background-color: rgba(39, 96, 101, 0.52);
    border-left-color: var(--deucarian-border-active);
    border-right-color: var(--deucarian-border-active);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border-active);
    color: var(--deucarian-text);
    -unity-font-style: bold;
}

/* Shared hybrid workbench -------------------------------------------------- */

.deucarian-workbench {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.deucarian-workbench__main {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: row;
}

.deucarian-workbench__content {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.deucarian-workbench__drawer {
    min-width: 0;
    min-height: 0;
}

.deucarian-workbench__footer {
    flex-shrink: 0;
}

.deucarian-workbench-toolbar,
.dpi-view-toolbar {
    margin-bottom: 8px;
    flex-wrap: wrap;
    align-items: center;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(90, 111, 160, 0.24);
    border-right-color: rgba(90, 111, 160, 0.20);
    border-top-color: rgba(128, 160, 192, 0.26);
    border-bottom-color: rgba(59, 166, 154, 0.14);
    background-color: rgba(12, 22, 31, 0.48);
}

.deucarian-workbench-toolbar__summary,
.dpi-view-toolbar__summary {
    margin-left: 8px;
    color: var(--deucarian-muted);
    font-size: 11px;
    min-width: 0;
    flex-shrink: 1;
}

.deucarian-workbench-toolbar__action,
.dpi-view-toolbar__action {
    height: 24px;
    min-width: 86px;
    margin-left: 4px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(90, 111, 160, 0.30);
    border-right-color: rgba(90, 111, 160, 0.24);
    border-top-color: rgba(126, 172, 202, 0.26);
    border-bottom-color: rgba(59, 166, 154, 0.18);
    background-color: rgba(22, 38, 48, 0.52);
    color: var(--deucarian-text);
}

.deucarian-workbench-toolbar__action--standard:hover,
.dpi-view-toolbar__graph-action:hover {
    border-left-color: rgba(59, 209, 191, 0.48);
    border-right-color: rgba(59, 209, 191, 0.38);
    border-top-color: rgba(126, 172, 202, 0.38);
    border-bottom-color: rgba(59, 209, 191, 0.34);
    background-color: rgba(28, 56, 64, 0.66);
    color: rgba(230, 244, 246, 0.96);
}

.deucarian-workbench-toolbar__action--standard:active,
.dpi-view-toolbar__graph-action:active {
    border-left-color: rgba(59, 209, 191, 0.72);
    border-right-color: rgba(59, 209, 191, 0.58);
    border-top-color: rgba(126, 172, 202, 0.52);
    border-bottom-color: rgba(59, 209, 191, 0.52);
    background-color: rgba(19, 43, 52, 0.78);
    color: rgba(238, 250, 251, 1.00);
}

.deucarian-workbench-toolbar__action--emphasized,
.deucarian-workbench-toolbar__toggle,
.dpi-view-toolbar__channel-button {
    min-width: 124px;
    margin-right: 2px;
    border-left-color: rgba(59, 166, 154, 0.42);
    border-right-color: rgba(59, 166, 154, 0.32);
    border-top-color: rgba(126, 172, 202, 0.30);
    border-bottom-color: rgba(59, 166, 154, 0.26);
    background-color: rgba(25, 53, 57, 0.54);
}

.deucarian-workbench-toolbar__toggle--active {
    background-color: rgba(39, 96, 101, 0.52);
    border-left-color: var(--deucarian-border-active);
    border-right-color: var(--deucarian-border-active);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border-active);
    color: var(--deucarian-text);
    -unity-font-style: bold;
}

.deucarian-workbench-toolbar__action--emphasized:hover,
.deucarian-workbench-toolbar__toggle:hover,
.dpi-view-toolbar__channel-button:hover {
    border-left-color: rgba(59, 209, 191, 0.58);
    border-right-color: rgba(59, 209, 191, 0.44);
    border-top-color: rgba(126, 172, 202, 0.42);
    border-bottom-color: rgba(59, 209, 191, 0.38);
    background-color: rgba(31, 70, 73, 0.68);
}

.deucarian-workbench-toolbar__spacer,
.dpi-view-toolbar__spacer {
    flex-grow: 1;
}

.deucarian-responsive--compact .deucarian-workbench-toolbar__action,
.deucarian-responsive--compact .dpi-view-toolbar__action,
.dpi-responsive--compact .deucarian-workbench-toolbar__action,
.dpi-responsive--compact .dpi-view-toolbar__action {
    min-width: 76px;
    padding-left: 6px;
    padding-right: 6px;
}

.deucarian-responsive--compact .deucarian-workbench-toolbar__action--emphasized,
.deucarian-responsive--compact .deucarian-workbench-toolbar__toggle,
.deucarian-responsive--compact .dpi-view-toolbar__channel-button,
.dpi-responsive--compact .deucarian-workbench-toolbar__action--emphasized,
.dpi-responsive--compact .deucarian-workbench-toolbar__toggle,
.dpi-responsive--compact .dpi-view-toolbar__channel-button {
    min-width: 112px;
}

.deucarian-responsive--narrow .deucarian-workbench__main,
.dpi-responsive--narrow .deucarian-workbench__main {
    flex-direction: column;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar,
.deucarian-responsive--narrow .dpi-view-toolbar,
.dpi-responsive--narrow .deucarian-workbench-toolbar,
.dpi-responsive--narrow .dpi-view-toolbar {
    height: 86px;
    min-height: 86px;
    max-height: 86px;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    align-content: flex-start;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar__spacer,
.deucarian-responsive--narrow .dpi-view-toolbar__spacer,
.dpi-responsive--narrow .deucarian-workbench-toolbar__spacer,
.dpi-responsive--narrow .dpi-view-toolbar__spacer {
    display: none;
}

.deucarian-responsive--narrow .deucarian-workbench-toolbar__summary,
.deucarian-responsive--narrow .dpi-view-toolbar__summary,
.dpi-responsive--narrow .deucarian-workbench-toolbar__summary,
.dpi-responsive--narrow .dpi-view-toolbar__summary {
    width: 100%;
    margin-left: 0;
    margin-top: 4px;
}

/* Shared workbench drawer and footer. The dpi aliases preserve the released
   Package Installer contract while allowing consumers to migrate incrementally. */

.deucarian-workbench-operation-surface,
.dpi-operation-surface {
    --deucarian-workbench-operation-inline-padding: 12px;
    --deucarian-workbench-operation-block-padding: 6px;
    --deucarian-workbench-operation-row-gap: 6px;
    --deucarian-workbench-operation-control-gap: 8px;
    --deucarian-workbench-operation-footer-height: 34px;
    --dpi-operation-inline-padding: 12px;
    --dpi-operation-block-padding: 6px;
    --dpi-operation-row-gap: 6px;
    --dpi-operation-control-gap: 8px;
    --dpi-operation-footer-height: 34px;
}

.deucarian-workbench-operation-drawer,
.dpi-operation-drawer {
    flex-shrink: 0;
    height: 0;
    min-height: 0;
    max-height: 0;
    margin-top: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    background-color: rgba(17, 29, 39, 0.00);
    overflow: hidden;
}

.deucarian-workbench-operation-drawer--expanded,
.dpi-operation-drawer--expanded {
    margin-bottom: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(59, 166, 154, 0.30);
    border-right-color: rgba(59, 166, 154, 0.30);
    border-top-color: rgba(90, 111, 160, 0.34);
    border-bottom-color: rgba(59, 166, 154, 0.24);
    background-color: rgba(10, 20, 30, 0.62);
}

.deucarian-workbench-operation-drawer--collapsed,
.dpi-operation-drawer--collapsed {
    margin-bottom: 0;
    background-color: rgba(17, 29, 39, 0.00);
}

.deucarian-workbench-operation-drawer__scroll,
.dpi-operation-drawer__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.deucarian-workbench-operation-content,
.dpi-operation-content {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-left: var(--deucarian-workbench-operation-inline-padding);
    padding-right: var(--deucarian-workbench-operation-inline-padding);
    padding-top: var(--deucarian-workbench-operation-block-padding);
    padding-bottom: var(--deucarian-workbench-operation-block-padding);
}

.deucarian-workbench-operation-row,
.dpi-operation-row {
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: var(--deucarian-workbench-operation-row-gap);
}

.deucarian-workbench-operation-row--header,
.deucarian-workbench-operation-row--option,
.dpi-operation-row--header,
.dpi-operation-row--option {
    flex-direction: row;
    align-items: center;
}

.deucarian-workbench-operation-row--message,
.dpi-operation-row--message {
    flex-shrink: 1;
    margin-bottom: 0;
}

.deucarian-workbench-operation-text--primary,
.dpi-operation-text--primary {
    color: var(--deucarian-text);
}

.deucarian-workbench-operation-text--secondary,
.dpi-operation-text--secondary {
    color: var(--deucarian-muted);
}

.deucarian-workbench-operation-drawer__title,
.dpi-operation-drawer__title {
    -unity-font-style: bold;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.deucarian-workbench-operation-drawer__toggle,
.dpi-operation-drawer__toggle {
    flex-shrink: 0;
    margin-left: 0;
    margin-right: var(--deucarian-workbench-operation-control-gap);
    margin-top: 0;
    margin-bottom: 0;
}

.deucarian-workbench-operation-drawer__option-label,
.dpi-operation-drawer__option-label {
    font-size: 11px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.deucarian-workbench-operation-drawer__message,
.dpi-operation-drawer__message {
    font-size: 11px;
    white-space: normal;
    overflow: visible;
}

.deucarian-workbench-operation-footer,
.dpi-operation-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: var(--deucarian-workbench-operation-footer-height);
    min-height: var(--deucarian-workbench-operation-footer-height);
    max-height: var(--deucarian-workbench-operation-footer-height);
    margin-top: 0;
    padding-left: var(--deucarian-workbench-operation-inline-padding);
    padding-right: var(--deucarian-workbench-operation-inline-padding);
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(90, 111, 160, 0.30);
    border-right-color: rgba(90, 111, 160, 0.30);
    border-top-color: rgba(90, 111, 160, 0.30);
    border-bottom-color: rgba(90, 111, 160, 0.30);
    background-color: rgba(12, 22, 31, 0.68);
    overflow: hidden;
}

.deucarian-workbench-operation-footer__status,
.dpi-operation-footer__status {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-width: 76px;
    margin-right: var(--deucarian-workbench-operation-control-gap);
}

.deucarian-workbench-operation-footer__status-icon,
.dpi-operation-footer__status-icon {
    width: 16px;
    min-width: 16px;
    max-width: 16px;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    margin-right: 5px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 11px;
}

.deucarian-workbench-operation-footer__status-icon--success,
.dpi-operation-footer__status-icon--installed {
    color: var(--deucarian-green);
}

.deucarian-workbench-operation-footer__status-icon--neutral,
.dpi-operation-footer__status-icon--not-installed,
.dpi-operation-footer__status-icon--info {
    color: var(--deucarian-muted);
}

.deucarian-workbench-operation-footer__status-icon--warning,
.dpi-operation-footer__status-icon--attention {
    color: var(--deucarian-amber);
}

.deucarian-workbench-operation-footer__status-icon--error,
.dpi-operation-footer__status-icon--failed {
    color: var(--deucarian-red);
}

.deucarian-workbench-operation-footer__status-icon--busy,
.dpi-operation-footer__status-icon--busy {
    color: var(--deucarian-teal);
}

.deucarian-workbench-operation-footer__status-label,
.dpi-operation-footer__status-label {
    flex-shrink: 0;
    color: var(--deucarian-text);
    font-size: 11px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.deucarian-workbench-operation-footer__summary,
.dpi-operation-footer__summary {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 0;
    margin-right: var(--deucarian-workbench-operation-control-gap);
    color: var(--deucarian-muted);
    font-size: 11px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.deucarian-workbench-operation-footer__spacer,
.dpi-operation-footer__spacer {
    width: 0;
    min-width: 0;
    max-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.deucarian-workbench-operation-footer__action,
.dpi-operation-footer__details-button {
    width: 96px;
    min-width: 96px;
    max-width: 96px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin-left: 0;
    margin-right: var(--deucarian-workbench-operation-control-gap);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(90, 111, 160, 0.38);
    border-right-color: rgba(90, 111, 160, 0.38);
    border-top-color: rgba(90, 111, 160, 0.38);
    border-bottom-color: rgba(90, 111, 160, 0.38);
    background-color: rgba(32, 47, 56, 0.60);
    color: var(--deucarian-text);
    font-size: 11px;
}

.deucarian-workbench-operation-footer__action:hover,
.dpi-operation-footer__details-button:hover {
    border-left-color: var(--deucarian-border-active);
    border-right-color: var(--deucarian-border-active);
    border-top-color: var(--deucarian-border-active);
    border-bottom-color: var(--deucarian-border-active);
    background-color: rgba(35, 62, 66, 0.66);
}

.deucarian-workbench-operation-footer__action:active,
.dpi-operation-footer__details-button:active {
    border-left-color: rgba(59, 209, 191, 0.76);
    border-right-color: rgba(59, 209, 191, 0.76);
    border-top-color: rgba(59, 209, 191, 0.76);
    border-bottom-color: rgba(59, 209, 191, 0.76);
    background-color: rgba(25, 50, 56, 0.78);
}

.deucarian-workbench-operation-footer__version,
.dpi-operation-footer__version {
    flex-shrink: 0;
    color: var(--deucarian-text);
    font-size: 11px;
    -unity-text-align: middle-right;
    white-space: nowrap;
    overflow: hidden;
}

.deucarian-section {
    margin-bottom: 14px;
}

.deucarian-section__title {
    margin-bottom: 8px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--deucarian-muted);
}

.deucarian-card {
    min-height: 112px;
    margin-right: 10px;
    margin-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--deucarian-border);
    border-right-color: var(--deucarian-border);
    border-top-color: var(--deucarian-border);
    border-bottom-color: var(--deucarian-border);
    background-color: var(--deucarian-panel);
}

.deucarian-card:hover {
    background-color: var(--deucarian-panel-soft);
}

.deucarian-badge {
    height: 20px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    background-color: #2b3b44;
    color: var(--deucarian-text);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.deucarian-badge--success {
    background-color: #2f6b4e;
}

.deucarian-badge--warning {
    background-color: #735b2e;
}

.deucarian-badge--error {
    background-color: #743737;
}

.deucarian-button {
    height: 28px;
    min-width: 94px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.deucarian-button--primary {
    background-color: #326e83;
    color: var(--deucarian-text);
    -unity-font-style: bold;
}

.deucarian-status-row {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    margin-bottom: 6px;
}

.deucarian-muted {
    color: var(--deucarian-muted);
}

.deucarian-fixed-wallpaper-layer,
.deucarian-fixed-wallpaper-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.deucarian-readability-overlay {
    background-color: rgba(2, 8, 14, 0.24);
}

.deucarian-wallpaper-safe-shell {
    overflow: hidden;
}

.deucarian-wallpaper-top-safe-fade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 86px;
    background-color: rgba(4, 10, 17, 0.58);
}

.deucarian-ambient-lighting-layer,
.deucarian-grain-layer,
.deucarian-vignette-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.deucarian-ambient-lighting-layer {
    overflow: hidden;
}

.deucarian-ambient-glow {
    position: absolute;
    width: 720px;
    height: 720px;
    -unity-background-scale-mode: scale-and-crop;
}

.deucarian-ambient-glow--teal {
    left: -170px;
    top: 38%;
}

.deucarian-ambient-glow--blue {
    right: -150px;
    top: 70px;
    width: 660px;
    height: 660px;
}

.deucarian-ambient-glow--indigo {
    right: 8%;
    bottom: -250px;
    width: 620px;
    height: 620px;
}

.deucarian-grain-layer {
    opacity: 0.24;
    -unity-background-scale-mode: scale-and-crop;
}

.deucarian-vignette-layer {
    opacity: 0.90;
    -unity-background-scale-mode: stretch-to-fill;
}

.deucarian-glass-sheen {
    position: absolute;
    left: -64px;
    top: -20%;
    width: 34px;
    height: 142%;
    background-color: rgba(218, 246, 250, 0.22);
    opacity: 0;
}
