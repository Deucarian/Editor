.deucarian-workspace .dw-loading-line-long { width: 66%; height: 17px; margin-top: 18px; }
.deucarian-workspace .dw-loading-badge { width: 13%; height: 24px; border-radius: 5px; background-color: var(--dw-border); }
.deucarian-workspace .dw-review-integrated .dw-review-split { height: 410px; min-height: 410px; margin: 0; }
.deucarian-workspace .dw-review-integrated .dw-review-split > .dw-form-pane { width: 43%; padding: 20px; border-width: 1px; border-color: var(--dw-border); border-radius: 5px; }
.deucarian-workspace .dw-review-integrated .dw-review-split > .dw-preview-pane { width: 57%; padding-left: 20px; border-left-width: 0; }
.deucarian-workspace .dw-review-integrated .dw-review-commit { flex-direction: row; align-items: flex-end; flex-wrap: wrap; padding-top: 18px; margin-top: 16px; border-top-width: 0; }
.deucarian-workspace .dw-review-integrated .dw-review-commit > .dw-field { flex-grow: 1; flex-basis: 65%; min-width: 180px; margin: 0 24px 0 0; }
.deucarian-workspace .dw-review-integrated .dw-review-commit > .dw-button { align-self: flex-end; margin-bottom: 0; }
.deucarian-workspace .dw-review-integrated .dw-review-commit .dw-field { flex-direction: column; align-items: stretch; }
.deucarian-workspace .dw-review-integrated .dw-review-commit .dw-field-label { padding-top: 0; margin-bottom: 12px; }
.deucarian-workspace .dw-review-integrated .dw-review-commit .dw-multiline { min-height: 82px; }
.deucarian-workspace .dw-review-integrated .dw-review-commit .dw-multiline .unity-base-field__input { height: 82px; min-height: 82px; }
.deucarian-workspace .dw-review-history-panel { padding: 20px 28px; border-width: 1px; border-color: var(--dw-border); border-radius: 5px; }
.deucarian-workspace .dw-review-history-panel > .unity-toggle { display: none; }
.deucarian-workspace .dw-review-history-panel > .unity-foldout__content { margin-left: 0; }
.deucarian-workspace .dw-review-history-split { min-height: 500px; flex-grow: 0; }
.deucarian-workspace .dw-review-history-split > .dw-form-pane { width: 54%; }
.deucarian-workspace .dw-review-history-split > .dw-preview-pane { padding: 24px 30px; border-width: 1px; border-color: var(--dw-border); border-radius: 5px; margin-left: 20px; }
.deucarian-workspace .dw-review-publish { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.deucarian-workspace .dw-review-publish > .dw-section-title,
.deucarian-workspace .dw-review-publish > .dw-field,
.deucarian-workspace .dw-review-publish > .dw-muted { width: 100%; flex-basis: 100%; }
.deucarian-workspace .dw-review-publish > .dw-button { flex-grow: 1; flex-basis: 40%; margin: 12px 8px 0 0; }
.deucarian-workspace .dw-review-publish > .dw-primary { flex-basis: 100%; margin-bottom: 20px; }
.deucarian-workspace .dw-review-publish > .dw-muted { margin-top: 20px; }
.deucarian-workspace .dw-review-history-split.dw-split-stacked > .dw-preview-pane { margin-left: 0; margin-top: 20px; }
.deucarian-workspace .dw-diff-lines { min-width: 100%; padding: 12px; }
.deucarian-workspace .dw-diff-line { min-height: 28px; margin: 0; white-space: nowrap; font-size: 21px; padding: 2px 8px; }
.deucarian-workspace .dw-diff-added { background-color: rgba(39,176,124,.12); color: #71d8a8; }
.deucarian-workspace .dw-diff-removed { background-color: rgba(204,79,90,.12); color: #f49197; }
.deucarian-workspace .dw-diff-range { color: var(--dw-accent); }
.deucarian-workspace.dw-light .dw-diff-added { color: #156a46; }
.deucarian-workspace.dw-light .dw-diff-removed { color: #a92b39; }
.deucarian-workspace .dw-review-integrated .dw-review-split.dw-split-stacked { height: 720px; min-height: 720px; }
.deucarian-workspace .dw-review-integrated .dw-review-split.dw-split-stacked > .dw-form-pane { width: auto; height: 320px; min-height: 320px; }
.deucarian-workspace .dw-review-integrated .dw-review-split.dw-split-stacked > .dw-preview-pane { width: auto; height: 380px; min-height: 380px; padding: 24px 0 0; }
.deucarian-workspace .dw-tree { margin-top: 28px; }
.deucarian-workspace .dw-tree-level { padding-left: 18px; }
.deucarian-workspace .dw-tree-row { justify-content: flex-start; min-width: 0; height: auto; min-height: 56px; padding: 8px; margin: 2px 0; }
.deucarian-workspace .dw-tree-row > .dw-label { white-space: normal; flex-shrink: 1; min-width: 0; -unity-text-align: middle-left; }
.deucarian-workspace .dw-tree-row.dw-selected { background-color: var(--dw-selected); }
