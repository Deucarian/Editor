.deucarian-workspace-host {
    --dw-background: #23282b;
    --dw-sidebar: #202528;
    --dw-field: #24292c;
    --dw-hover: #30393d;
    --dw-border: #41494e;
    --dw-text: #f2f4f7;
    --dw-muted: #bac3cd;
    --dw-accent: #72e1df;
    --dw-selected: #214e52;
    --dw-primary: #178f94;
    --dw-primary-hover: #1ba3a8;
    --dw-warning: #ffcb4a;
    --dw-error: #ff6b70;
    --dw-info: #56baff;
    --dw-success: #69cea0;
}
.deucarian-workspace-host.deucarian-theme--light {
    --dw-background: #f6f8fa;
    --dw-sidebar: #edf1f4;
    --dw-field: #ffffff;
    --dw-hover: #e4edf0;
    --dw-border: #bdc9d0;
    --dw-text: #202a32;
    --dw-muted: #52616d;
    --dw-accent: #006970;
    --dw-selected: #d5eeee;
    --dw-primary: #087b81;
    --dw-primary-hover: #08686d;
    --dw-warning: #956300;
    --dw-error: #c63140;
    --dw-info: #166eb0;
    --dw-success: #20764f;
}
.deucarian-workspace-host .deucarian-window-background,
.deucarian-workspace-host .deucarian-window-overlay { display: none; }
.deucarian-workspace-host .deucarian-window-shell { background-color: var(--dw-background); }
.deucarian-workspace {
    padding: 0; margin: 0;
    color: var(--dw-text); background-color: var(--dw-background);
    font-size: 16px;
    -unity-font: url("../Fonts/DINish-Regular.otf");
}
.deucarian-workspace .deucarian-workbench__main { flex-direction: row; padding: 0; margin: 0; min-height: 0; }
.deucarian-workspace .unity-label { padding: 0; margin: 0; }
.deucarian-workspace .dw-header {
    height: 64px; min-height: 64px; flex-direction: row; align-items: center;
    border-bottom-width: 1px; border-bottom-color: var(--dw-border);
    padding-right: 20px; background-color: var(--dw-sidebar);
}
.deucarian-workspace .dw-brand { width: 218px; flex-direction: row; align-items: center; padding-left: 26px; flex-shrink: 0; }
.deucarian-workspace .dw-brand-name { font-size: 25px; -unity-font: url("../Fonts/DINish-SemiBold.otf"); -unity-font-style: bold; margin-left: 16px; }
.deucarian-workspace .dw-icon { width: 26px; height: 26px; flex-shrink: 0; -unity-background-image-tint-color: var(--dw-text); }
.deucarian-workspace .dw-spacer { flex-grow: 1; }
.deucarian-workspace .dw-button {
    height: 36px; min-height: 36px; padding: 0 14px; margin: 0;
    border-width: 1px; border-color: #69737d; border-radius: 5px;
    color: var(--dw-text); background-color: var(--dw-field);
    font-size: 16px; -unity-font-style: normal;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.deucarian-workspace .dw-button:hover { background-color: var(--dw-hover); border-color: var(--dw-accent); }
.deucarian-workspace .dw-button:focus { border-color: var(--dw-accent); }
.deucarian-workspace .dw-button:active { background-color: var(--dw-selected); }
.deucarian-workspace .dw-button:disabled { opacity: 0.45; }
.deucarian-workspace .dw-primary { background-color: var(--dw-primary); border-color: #46c4c7; color: #ffffff; height: 42px; -unity-font-style: bold; }
.deucarian-workspace .dw-primary:hover { background-color: var(--dw-primary-hover); }
.deucarian-workspace .dw-project { width: 200px; -unity-text-align: middle-left; border-color: var(--dw-border); }
.deucarian-workspace .dw-search {
    width: 360px; height: 42px; flex-direction: row; align-items: center;
    border-width: 1px; border-color: var(--dw-border); border-radius: 5px;
    padding-left: 12px; background-color: var(--dw-field);
}
.deucarian-workspace .dw-search .dw-icon { width: 22px; height: 22px; }
.deucarian-workspace .dw-search .unity-text-field { flex-grow: 1; margin: 0; }
.deucarian-workspace .dw-search .unity-text-field__input { border-width: 0; background-color: transparent; color: var(--dw-text); font-size: 16px; padding-left: 10px; }
.deucarian-workspace .dw-search-placeholder { position: absolute; left: 46px; right: 10px; top: 10px; color: var(--dw-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.deucarian-workspace .dw-sidebar { width: 238px; min-width: 238px; padding-top: 14px; border-right-width: 1px; border-right-color: var(--dw-border); background-color: var(--dw-sidebar); }
.deucarian-workspace .dw-navigation { flex-shrink: 0; }
.deucarian-workspace .dw-nav-item {
    flex-direction: row; align-items: center; justify-content: flex-start;
    border-radius: 0; border-width: 0; border-left-width: 5px; border-left-color: transparent;
    background-color: transparent; height: 58px; padding-left: 25px; -unity-text-align: middle-left;
}
.deucarian-workspace .dw-nav-item .dw-icon { margin-right: 24px; }
.deucarian-workspace .dw-nav-item.dw-selected { background-color: var(--dw-selected); border-left-color: #35c8c7; color: var(--dw-accent); }
.deucarian-workspace .dw-nav-item.dw-selected .dw-icon { -unity-background-image-tint-color: var(--dw-accent); }
.deucarian-workspace .dw-navigation-footer { border-top-width: 1px; border-top-color: var(--dw-border); padding-top: 9px; padding-bottom: 14px; }
.deucarian-workspace .dw-page { padding: 22px 30px 0 28px; min-width: 0; }
.deucarian-workspace .dw-page-header { flex-direction: row; align-items: flex-start; margin-bottom: 18px; flex-shrink: 0; }
.deucarian-workspace .dw-heading { flex-grow: 1; min-width: 0; }
.deucarian-workspace .dw-title { font-size: 34px; -unity-font: url("../Fonts/DINish-SemiBold.otf"); -unity-font-style: bold; margin-bottom: 2px; }
.deucarian-workspace .dw-subtitle { font-size: 18px; color: var(--dw-muted); white-space: normal; }
.deucarian-workspace .dw-page-actions { margin-top: 4px; margin-left: 16px; flex-direction: row; }
.deucarian-workspace .dw-tabs { border-bottom-width: 1px; border-bottom-color: var(--dw-border); flex-shrink: 0; }
.deucarian-workspace .dw-tab-bar { flex-direction: row; }
.deucarian-workspace .dw-tab-bar .dw-button { border-width: 0; border-bottom-width: 4px; border-bottom-color: transparent; border-radius: 0; background-color: transparent; height: 44px; padding: 0 22px; font-size: 18px; }
.deucarian-workspace .dw-tab-bar .dw-selected { color: var(--dw-accent); border-bottom-color: #35c8c7; }
.deucarian-workspace .dw-scope { min-height: 64px; flex-shrink: 0; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: var(--dw-border); padding: 12px 0; }
.deucarian-workspace .dw-scope .dw-label { margin-right: 32px; }
.deucarian-workspace .dw-scope .dw-muted { margin-left: 22px; }
.deucarian-workspace .dw-choice-bar { flex-direction: row; flex-shrink: 1; min-width: 0; max-width: 100%; }
.deucarian-workspace .dw-choice-bar .dw-button { border-color: var(--dw-border); padding: 6px 12px; border-radius: 0; flex-grow: 1; flex-shrink: 1; min-width: 0; height: auto; white-space: normal; }
.deucarian-workspace .dw-choice-bar .dw-first { border-top-left-radius: 5px; border-bottom-left-radius: 5px; }
.deucarian-workspace .dw-choice-bar .dw-last { border-top-right-radius: 5px; border-bottom-right-radius: 5px; }
.deucarian-workspace .dw-choice-bar .dw-selected { border-color: #35c8c7; background-color: var(--dw-selected); }
.deucarian-workspace .dw-content { flex-grow: 1; min-height: 0; padding-top: 12px; }
.deucarian-workspace .dw-split { flex-direction: row; flex-grow: 1; min-height: 0; }
.deucarian-workspace .dw-form-pane { width: 37%; min-width: 0; flex-shrink: 0; padding: 6px 24px 18px 4px; border-right-width: 1px; border-right-color: var(--dw-border); }
.deucarian-workspace .dw-preview-pane { flex-grow: 1; min-width: 0; padding: 6px 0 18px 20px; }
.deucarian-workspace .dw-scroll { flex-grow: 1; min-height: 0; }
.deucarian-workspace .dw-scroll .unity-scroll-view__content-container { min-width: 0; }
.deucarian-workspace .dw-section-title { font-size: 20px; -unity-font: url("../Fonts/DINish-SemiBold.otf"); -unity-font-style: bold; margin-bottom: 14px; }
.deucarian-workspace .dw-field { flex-direction: row; min-width: 0; margin-bottom: 12px; align-items: flex-start; flex-shrink: 0; }
.deucarian-workspace .dw-field-label { width: 128px; padding-top: 8px; padding-right: 12px; flex-shrink: 0; white-space: normal; }
.deucarian-workspace .dw-field-input { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0; }
.deucarian-workspace .unity-base-field__input { border-color: #59636b; border-width: 1px; border-radius: 5px; background-color: var(--dw-field); color: var(--dw-text); min-height: 36px; padding: 6px 10px; font-size: 16px; -unity-text-align: middle-left; }
.deucarian-workspace .unity-base-field__input:focus { border-color: var(--dw-accent); }
.deucarian-workspace .unity-base-field__label { color: var(--dw-text); }
.deucarian-workspace .dw-multiline .unity-base-field__input { height: 96px; -unity-text-align: upper-left; white-space: normal; }
.deucarian-workspace .dw-muted { color: var(--dw-muted); font-size: 16px; white-space: normal; }
.deucarian-workspace .dw-preview-toolbar { flex-direction: row; align-items: center; padding-bottom: 14px; flex-wrap: wrap; border-bottom-width: 1px; border-bottom-color: var(--dw-border); }
.deucarian-workspace .dw-preview-toolbar .dw-section-title { margin-bottom: 4px; margin-right: 12px; flex-grow: 1; }
.deucarian-workspace .dw-preview-toolbar .dw-muted { font-size: 14px; margin-right: 12px; }
.deucarian-workspace .dw-preview-toolbar .dw-link { padding-left: 0; margin-top: 4px; }
.deucarian-workspace .dw-link { border-width: 0; background-color: transparent; color: var(--dw-info); padding: 0 0 0 22px; min-height: 24px; height: 24px; }
.deucarian-workspace .dw-message { min-height: 80px; flex-shrink: 0; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: var(--dw-border); padding: 12px 8px 12px 18px; }
.deucarian-workspace .dw-message-marker { position: absolute; left: 0; top: 8px; bottom: 8px; width: 5px; background-color: var(--dw-muted); }
.deucarian-workspace .dw-message .dw-icon { width: 26px; height: 26px; margin-right: 16px; }
.deucarian-workspace .dw-message-text { flex-grow: 1; min-width: 0; padding-right: 16px; }
.deucarian-workspace .dw-message-title { font-size: 18px; -unity-font: url("../Fonts/DINish-SemiBold.otf"); -unity-font-style: bold; white-space: normal; }
.deucarian-workspace .dw-message-trailing { min-width: 0; margin-top: 5px; }
.deucarian-workspace .dw-message-state { font-size: 13px; color: var(--dw-muted); white-space: normal; }
.deucarian-workspace .dw-message .dw-button { min-height: 38px; height: 38px; padding: 0 16px; }
.deucarian-workspace .dw-message--warning .dw-message-marker { background-color: var(--dw-warning); }
.deucarian-workspace .dw-message--error .dw-message-marker { background-color: var(--dw-error); }
.deucarian-workspace .dw-message--info .dw-message-marker { background-color: var(--dw-info); }
.deucarian-workspace .dw-message--success .dw-message-marker { background-color: var(--dw-success); }
.deucarian-workspace .dw-message--warning .dw-icon { -unity-background-image-tint-color: var(--dw-warning); }
.deucarian-workspace .dw-message--error .dw-icon { -unity-background-image-tint-color: var(--dw-error); }
.deucarian-workspace .dw-message--info .dw-icon { -unity-background-image-tint-color: var(--dw-info); }
.deucarian-workspace .dw-message--success .dw-icon { -unity-background-image-tint-color: var(--dw-success); }
.deucarian-workspace .dw-progress { height: 5px; margin-top: 8px; background-color: #49525a; border-radius: 3px; }
.deucarian-workspace .dw-progress-fill { height: 5px; background-color: var(--dw-info); border-radius: 3px; }
.deucarian-workspace .dw-footer { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 48px; padding-top: 8px; padding-bottom: 8px; flex-wrap: wrap; border-top-width: 1px; border-top-color: var(--dw-border); }
.deucarian-workspace .dw-foldout { margin: 16px 0 10px 0; font-size: 18px; flex-shrink: 0; }
.deucarian-workspace .dw-foldout > .unity-toggle { margin: 0; }
.deucarian-workspace .dw-foldout > .unity-toggle > .unity-toggle__input { background-color: transparent; border-width: 0; padding: 0; min-height: 30px; }
.deucarian-workspace .dw-foldout > .unity-toggle > .unity-toggle__input > .unity-toggle__text { margin-left: 12px; }
.deucarian-workspace .dw-note { margin-top: 14px; margin-bottom: 10px; }
.deucarian-workspace .dw-form-action { margin-bottom: 8px; align-self: flex-start; max-width: 100%; height: auto; padding-top: 8px; padding-bottom: 8px; white-space: normal; }
.deucarian-workspace .dw-form-section { margin-bottom: 18px; }
.deucarian-workspace .dw-lab-page { padding-right: 6px; }
.deucarian-workspace .dw-settings-page .dw-form-section { max-width: 850px; padding: 10px 4px; }
.deucarian-workspace .dw-settings-page .dw-field-label { width: 220px; white-space: normal; }
.deucarian-workspace .dw-field-input.unity-toggle .unity-toggle__checkmark { width: 20px; height: 20px; border-width: 1px; border-color: var(--dw-border); }
.deucarian-workspace .dw-target-picker { max-width: 320px; margin-left: 16px; }
.deucarian-workspace .dw-empty { white-space: normal; color: var(--dw-muted); padding: 40px 0; }
.deucarian-workspace .unity-toggle__input { min-height: 30px; border-width: 0; background-color: transparent; padding-left: 0; }
.deucarian-workspace .dw-preview-label { height: 28px; min-height: 28px; font-size: 12px; color: var(--dw-muted); -unity-text-align: middle-center; border-bottom-width: 1px; border-bottom-color: var(--dw-border); }
.deucarian-workspace.dw-compact .dw-sidebar { width: 184px; min-width: 184px; }
.deucarian-workspace.dw-compact .dw-brand { width: 184px; padding-left: 18px; }
.deucarian-workspace.dw-compact .dw-brand-name { font-size: 21px; margin-left: 10px; }
.deucarian-workspace.dw-compact .dw-nav-item { padding-left: 16px; }
.deucarian-workspace.dw-compact .dw-nav-item .dw-icon { margin-right: 14px; }
.deucarian-workspace.dw-compact .dw-page { padding-left: 18px; padding-right: 18px; }
.deucarian-workspace.dw-compact .dw-title { font-size: 28px; }
.deucarian-workspace.dw-compact .dw-subtitle { font-size: 16px; }
.deucarian-workspace.dw-compact .dw-search { width: 220px; }
.deucarian-workspace.dw-compact .dw-project { width: 160px; }
.deucarian-workspace.dw-compact .dw-scope { flex-wrap: wrap; }
.deucarian-workspace.dw-compact .dw-scope .dw-muted { margin-left: 0; margin-top: 8px; }
.deucarian-workspace.dw-narrow .deucarian-workbench__main { flex-direction: column; }
.deucarian-workspace.dw-narrow .dw-header { flex-wrap: wrap; height: auto; min-height: 64px; padding: 8px 12px; }
.deucarian-workspace.dw-narrow .dw-brand { width: auto; padding-left: 0; margin-right: 18px; }
.deucarian-workspace.dw-narrow .dw-search { width: 100%; margin-top: 8px; }
.deucarian-workspace.dw-narrow .dw-sidebar { width: auto; min-width: 0; flex-direction: row; border-right-width: 0; border-bottom-width: 1px; border-bottom-color: var(--dw-border); padding: 0; }
.deucarian-workspace.dw-narrow .dw-navigation { flex-direction: row; flex-wrap: wrap; flex-shrink: 1; }
.deucarian-workspace.dw-narrow .dw-navigation-footer { border-top-width: 0; padding: 0; }
.deucarian-workspace.dw-narrow .dw-nav-item { height: 38px; min-height: 38px; padding: 0 8px; font-size: 13px; border-left-width: 0; border-bottom-width: 3px; }
.deucarian-workspace.dw-narrow .dw-nav-item .dw-icon { display: none; }
.deucarian-workspace.dw-narrow .dw-page-header { flex-direction: column; }
.deucarian-workspace.dw-narrow .dw-page-actions { margin-left: 0; margin-top: 12px; }
.deucarian-workspace.dw-narrow .dw-choice-bar .dw-button { padding-left: 12px; padding-right: 12px; }
.deucarian-workspace.dw-narrow .dw-preview-label { height: auto; min-height: 28px; white-space: normal; }
.deucarian-workspace.dw-narrow .dw-footer { flex-wrap: wrap; min-height: 58px; padding-top: 8px; padding-bottom: 8px; }
.deucarian-workspace.dw-narrow .dw-message { flex-wrap: wrap; padding-left: 14px; }
.deucarian-workspace.dw-narrow .dw-message .dw-icon { width: 22px; margin-right: 12px; }
.deucarian-workspace.dw-narrow .dw-message-trailing { width: auto; }
.deucarian-workspace.dw-narrow .dw-preview-toolbar { flex-wrap: wrap; }
.deucarian-workspace .dw-actions { flex-direction: row; flex-wrap: wrap; margin-bottom: 10px; }
.deucarian-workspace .dw-actions .dw-button { margin-right: 8px; margin-bottom: 8px; }
.deucarian-workspace .dw-readonly { white-space: normal; padding-top: 8px; color: var(--dw-muted); }
.deucarian-workspace .dw-embedded { flex-grow: 1; min-height: 0; }
.deucarian-workspace .dw-collection-row { border-left-width: 3px; border-left-color: transparent; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: var(--dw-border); padding: 8px 10px; flex-shrink: 0; }
.deucarian-workspace .dw-collection-row.dw-selected { background-color: var(--dw-selected); border-left-width: 3px; border-left-color: var(--dw-accent); }
.deucarian-workspace .dw-collection-select { height: auto; min-height: 52px; background-color: transparent; border-width: 0; flex-grow: 1; flex-shrink: 1; min-width: 0; align-items: flex-start; justify-content: center; padding: 6px; border-radius: 0; border-bottom-width: 2px; border-bottom-color: transparent; }
.deucarian-workspace .dw-collection-select .dw-muted { font-size: 14px; white-space: normal; }
.deucarian-workspace .dw-collection-select:hover { background-color: transparent; border-color: transparent; }
.deucarian-workspace .dw-collection-select:focus { background-color: transparent; border-color: transparent; border-bottom-color: var(--dw-accent); }
.deucarian-workspace .dw-collection-status { font-size: 13px; color: var(--dw-muted); max-width: 120px; white-space: normal; margin-left: 8px; margin-right: 8px; }
.deucarian-workspace .dw-collection-action { height: 34px; min-height: 34px; font-size: 14px; padding: 0 12px; }
.deucarian-workspace .dw-collection-split > .dw-form-pane { width: 55%; }
.deucarian-workspace .dw-collection-split > .dw-preview-pane { width: 45%; }
.deucarian-workspace .dw-page-actions .dw-button { margin-left: 8px; }
.deucarian-workspace .dw-page-actions { flex-wrap: wrap; }
.deucarian-workspace .dw-tab-bar { flex-wrap: wrap; }
.deucarian-workspace .dw-control-sections { flex-direction: row; flex-wrap: wrap; margin-bottom: 12px; }
.deucarian-workspace .dw-control-sections .dw-button { margin-right: 4px; margin-bottom: 4px; background-color: transparent; border-color: transparent; border-radius: 0; border-bottom-width: 3px; }
.deucarian-workspace .dw-control-sections .dw-selected { border-bottom-color: var(--dw-accent); color: var(--dw-accent); }
.deucarian-workspace .dw-summary-card { border-width: 0; border-top-width: 1px; border-color: var(--dw-border); background-color: transparent; min-width: 0; flex-shrink: 1; }
.deucarian-workspace .dw-summary-card .unity-button { font-size: 14px; max-width: 100%; height: auto; min-height: 32px; padding: 6px 10px; white-space: normal; border-radius: 4px; background-color: var(--dw-field); border-color: var(--dw-border); color: var(--dw-text); }
.deucarian-workspace .dw-summary-card .unity-button:hover { background-color: var(--dw-hover); border-color: var(--dw-accent); }
.deucarian-workspace .dw-scope { flex-wrap: wrap; }
.deucarian-workspace .dw-scope .dw-field { min-width: 0; flex-basis: 300px; max-width: 500px; flex-grow: 1; margin-right: 20px; margin-bottom: 8px; }
.deucarian-workspace .dw-footer .deucarian-workbench-operation-footer { flex-grow: 1; background-color: transparent; border-width: 0; }
.deucarian-workspace .dw-field.dw-field-stacked { flex-direction: column; }
.deucarian-workspace .dw-field.dw-field-stacked > .dw-field-label { width: auto; padding-top: 0; padding-right: 0; margin-bottom: 6px; }
.deucarian-workspace .dw-field.dw-field-stacked > .dw-field-input { width: 100%; }
.deucarian-workspace .dw-field.dw-field-stacked > .dw-readonly { padding-top: 0; }
.deucarian-workspace .dw-split.dw-split-stacked { flex-direction: column; }
.deucarian-workspace .dw-split.dw-split-stacked > .dw-form-pane { width: auto; border-right-width: 0; border-bottom-width: 1px; border-bottom-color: var(--dw-border); padding-right: 0; }
.deucarian-workspace .dw-split.dw-split-stacked > .dw-preview-pane { width: auto; padding-left: 0; margin-top: 16px; }
.deucarian-workspace .dw-collection-split.dw-split-stacked > .dw-form-pane { flex-basis: 38%; flex-shrink: 1; max-height: 230px; padding-bottom: 8px; }
.deucarian-workspace .dw-collection-split.dw-split-stacked > .dw-preview-pane { flex-basis: 0; flex-grow: 1; }
.deucarian-workspace .unity-object-field__display { align-items: center; min-width: 0; padding-top: 0; padding-bottom: 0; }
.deucarian-workspace .unity-object-field__display > .unity-label { -unity-text-align: middle-left; overflow: hidden; text-overflow: ellipsis; }
.deucarian-workspace .unity-base-popup-field__text { -unity-text-align: middle-left; }
.deucarian-workspace .dw-control-center, .deucarian-workspace .dw-control-layout { flex-grow: 1; min-height: 0; min-width: 0; }
.deucarian-workspace .dw-control-layout > .dw-scroll { padding-right: 6px; }
.deucarian-workspace .dw-card-heading { margin-bottom: 8px; }
.deucarian-workspace .dw-card-heading > .unity-label { margin-right: 12px; }
.deucarian-workspace .dw-tool-row { flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: var(--dw-border); padding: 12px 0; min-width: 0; flex-shrink: 0; }
.deucarian-workspace .dw-tool-text { flex-grow: 1; flex-shrink: 1; min-width: 0; padding-right: 18px; }
.deucarian-workspace .dw-tool-text > .dw-muted { margin-top: 4px; font-size: 14px; }
.deucarian-workspace .dw-tool-row > .dw-actions { margin-bottom: 0; flex-shrink: 0; }
.deucarian-workspace .dw-tool-row > .dw-actions > .dw-button { margin-bottom: 0; font-size: 14px; }
.deucarian-workspace .dw-tool-row.dw-tool-stacked { flex-direction: column; align-items: stretch; }
.deucarian-workspace .dw-tool-row.dw-tool-stacked > .dw-actions { margin-top: 10px; }
.deucarian-workspace .dw-footer > .dw-muted { font-size: 14px; flex-shrink: 1; }
